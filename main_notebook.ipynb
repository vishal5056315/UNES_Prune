for epoch in range(1, num_epochs + 1):

    start_time = time.time()

    # -------------------------
    # Training
    # -------------------------
    swin_model.train()

    train_loss = 0.0
    train_correct = 0
    train_total = 0

    total_train_batches = len(train_loader)

    for batch_idx, (images, targets) in enumerate(train_loader, start=1):

        images = images.to(device, non_blocking=True)
        targets = targets.to(device, non_blocking=True)

        optimizer.zero_grad(set_to_none=True)

        logits = swin_model(images)
        loss = criterion(logits, targets)

        loss.backward()
        optimizer.step()

        train_loss += loss.item() * targets.size(0)

        predictions = logits.argmax(dim=1)
        train_correct += (predictions == targets).sum().item()
        train_total += targets.size(0)

        progress = batch_idx / total_train_batches * 100

        if batch_idx == 1 or batch_idx % 25 == 0 or batch_idx == total_train_batches:
            print(
                f"Epoch {epoch:02d}/{num_epochs} | "
                f"Train {progress:6.2f}% | "
                f"Batch {batch_idx:03d}/{total_train_batches}",
                end="\r"
            )

    train_loss /= train_total
    train_acc = 100.0 * train_correct / train_total

    # -------------------------
    # Validation
    # -------------------------
    swin_model.eval()

    val_loss = 0.0
    val_correct = 0
    val_total = 0

    with torch.no_grad():

        total_val_batches = len(val_loader)

        for batch_idx, (images, targets) in enumerate(val_loader, start=1):

            images = images.to(device, non_blocking=True)
            targets = targets.to(device, non_blocking=True)

            logits = swin_model(images)
            loss = criterion(logits, targets)

            val_loss += loss.item() * targets.size(0)

            predictions = logits.argmax(dim=1)
            val_correct += (predictions == targets).sum().item()
            val_total += targets.size(0)

            progress = batch_idx / total_val_batches * 100

            if batch_idx == 1 or batch_idx % 5 == 0 or batch_idx == total_val_batches:
                print(
                    f"Epoch {epoch:02d}/{num_epochs} | "
                    f"Validation {progress:6.2f}% | "
                    f"Batch {batch_idx:03d}/{total_val_batches}",
                    end="\r"
                )

    val_loss /= val_total
    val_acc = 100.0 * val_correct / val_total

    scheduler.step()

    epoch_time = time.time() - start_time
    current_lr = optimizer.param_groups[0]["lr"]

