import copy
import torch

print("Constructing 49.37% structured-pruned Swin")
print("============================================")

original = copy.deepcopy(model)
pruned_model_49 = copy.deepcopy(original)

target_hidden = 96

for block_idx, block in enumerate(pruned_model_49.blocks):

    old_fc1 = block.mlp[0]
    old_fc2 = block.mlp[2]

    input_dim = old_fc1.in_features
    hidden_dim = old_fc1.out_features
    output_dim = old_fc2.out_features

    if hidden_dim != 384:
        raise ValueError(
            f"Unexpected hidden dimension in block {block_idx}: "
            f"{hidden_dim}"
        )

    importance = (
        old_fc1.weight.detach().abs().sum(dim=1)
        +
        old_fc2.weight.detach().abs().sum(dim=0)
    )

    keep_indices = torch.topk(
        importance,
        k=target_hidden,
        largest=True,
        sorted=True
    ).indices

    keep_indices = keep_indices.to(
        old_fc1.weight.device
    )

    new_fc1 = torch.nn.Linear(
        input_dim,
        target_hidden,
        bias=True
    ).to(old_fc1.weight.device)

    new_fc2 = torch.nn.Linear(
        target_hidden,
        output_dim,
        bias=True
    ).to(old_fc2.weight.device)

    with torch.no_grad():

        new_fc1.weight.copy_(
            old_fc1.weight[keep_indices]
        )

        new_fc1.bias.copy_(
            old_fc1.bias[keep_indices]
        )

        new_fc2.weight.copy_(
            old_fc2.weight[:, keep_indices]
        )

        new_fc2.bias.copy_(
            old_fc2.bias
        )

    block.mlp[0] = new_fc1
    block.mlp[2] = new_fc2


original_params = sum(
    p.numel() for p in original.parameters()
)

pruned_params = sum(
    p.numel() for p in pruned_model_49.parameters()
)

reduction = (
    (original_params - pruned_params)
    / original_params * 100
)

print(f"\nOriginal parameters : {original_params:,}")
print(f"Pruned parameters   : {pruned_params:,}")
print(f"Parameters removed  : {original_params - pruned_params:,}")
print(f"Reduction           : {reduction:.4f}%")

print("\nMLP dimensions:")

for i, block in enumerate(pruned_model_49.blocks):
    print(
        f"Block {i+1}: "
        f"{tuple(block.mlp[0].weight.shape)} -> "
        f"{tuple(block.mlp[2].weight.shape)}"
    )

sample = X_test_swin[:4].to(
    next(pruned_model_49.parameters()).device
)

pruned_model_49.eval()

with torch.no_grad():
    output = pruned_model_49(sample)

print("\nForward-pass:")
print("Input :", tuple(sample.shape))
print("Output:", tuple(output.shape))
print("Finite:", torch.isfinite(output).all().item())

print("\nArchitecture construction completed: 100%")


