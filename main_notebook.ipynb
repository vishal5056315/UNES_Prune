from pathlib import Path
from PIL import Image
import pandas as pd
import numpy as np
from tqdm.auto import tqdm

print("=" * 70)
print("STEP 2: MRI–MASK PAIR VERIFICATION")
print("=" * 70)

# Dataset root from Step 1
lgg_root = Path(
    "/kaggle/input/datasets/mateuszbuda/lgg-mri-segmentation/kaggle_3m"
)

# ------------------------------------------------------------
# 1. Find MRI images
# ------------------------------------------------------------
print("\n[1/4] Finding MRI images...")

all_tif_files = list(lgg_root.rglob("*.tif"))

# MRI files do NOT contain "_mask"
mri_files = [
    p for p in all_tif_files
    if "_mask" not in p.stem.lower()
]

print("MRI images found:", len(mri_files))


# ------------------------------------------------------------
# 2. Match every MRI with its mask
# ------------------------------------------------------------
print("\n[2/4] Matching MRI images with masks...")

records = []

missing_masks = []
size_mismatches = []
reading_errors = []

for mri_path in tqdm(
    mri_files,
    desc="Checking MRI-mask pairs",
    unit="pair"
):
    
    # Example:
    # TCGA_xxx_1.tif
    # -> TCGA_xxx_1_mask.tif
    mask_path = mri_path.with_name(
        mri_path.stem + "_mask.tif"
    )
    
    record = {
        "patient_id": mri_path.parent.name,
        "mri_path": str(mri_path),
        "mask_path": str(mask_path),
        "mri_exists": True,
        "mask_exists": mask_path.exists(),
        "mri_size": None,
        "mask_size": None,
        "mask_pixels": None,
        "mask_status": None,
        "valid_pair": False,
        "error": None
    }
    
    # Check mask existence
    if not mask_path.exists():
        missing_masks.append(str(mri_path))
        record["error"] = "Missing mask"
        records.append(record)
        continue
    
    try:
        # Read MRI and mask
        with Image.open(mri_path) as mri_img:
            mri_size = mri_img.size
        
        with Image.open(mask_path) as mask_img:
            mask_size = mask_img.size
            
            # Convert mask to array for pixel analysis
            mask_array = np.array(mask_img)
            
            # Count non-zero mask pixels
            mask_pixels = int(np.count_nonzero(mask_array))
        
        record["mri_size"] = mri_size
        record["mask_size"] = mask_size
        record["mask_pixels"] = mask_pixels
        
        # Determine positive/negative mask
        if mask_pixels > 0:
            record["mask_status"] = "positive"
        else:
            record["mask_status"] = "negative"
        
        # Check dimensions
        if mri_size != mask_size:
            size_mismatches.append({
                "mri": str(mri_path),
                "mask": str(mask_path),
                "mri_size": mri_size,
                "mask_size": mask_size
            })
            record["error"] = "Size mismatch"
        else:
            record["valid_pair"] = True
    
    except Exception as e:
        reading_errors.append({
            "mri": str(mri_path),
            "mask": str(mask_path),
            "error": str(e)
        })
        record["error"] = str(e)
    
    records.append(record)


# ------------------------------------------------------------
# 3. Create verification DataFrame
# ------------------------------------------------------------
print("\n[3/4] Creating verification summary...")

verification_df = pd.DataFrame(records)

valid_df = verification_df[
    verification_df["valid_pair"] == True
].copy()

positive_df = valid_df[
