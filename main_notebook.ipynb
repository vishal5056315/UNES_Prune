def exact_forward(self, x):

    e0, e1, e2, e3 = self.encoder(x)

    # 128 x 128
    x_0_0 = self.x_0_0(e0)

    # 32 x 32
    e3_up = self.upsample_to(e3, e2)

    x_3_3 = self.x_3_3(
        torch.cat(
            [e2, e3_up],
            dim=1
        )
    )

    # 64 x 64
    x_3_3_up = self.upsample_to(
        x_3_3,
        e1
    )

    x_2_2 = self.x_2_2(
        torch.cat(
            [e1, x_3_3_up],
            dim=1
        )
    )

    # 128 x 128
    x_2_2_up = self.upsample_to(
        x_2_2,
        x_0_0
    )

    x_1_1 = self.x_1_1(
        torch.cat(
            [e0, x_2_2_up],
            dim=1
        )
    )

    x_0_1 = self.x_0_1(
        torch.cat(
            [
                x_0_0,
                x_1_1
            ],
            dim=1
        )
    )

    # x_1_2: 64 + 64 + 128 = 256
    x_1_2 = self.x_1_2(
        torch.cat(
            [
                x_0_0,
                x_1_1,
                x_2_2_up
            ],
            dim=1
        )
    )

    # 64 x 64
    x_3_3_up_2 = self.upsample_to(
        x_3_3,
        x_2_2
    )

    x_2_3 = self.x_2_3(
        torch.cat(
            [
                e1,
                x_2_2,
                x_3_3_up_2
            ],
            dim=1
        )
    )

    # 128 x 128
    x_0_2 = self.x_0_2(
        torch.cat(
            [
                x_0_0,
                x_0_1,
                x_1_2
            ],
            dim=1
        )
    )

    # x_1_3: 64 + 64 + 64 + 128 = 320
    x_2_3_up = self.upsample_to(
        x_2_3,
        x_1_2
    )

    x_1_3 = self.x_1_3(
        torch.cat(
            [
                x_0_0,
                x_1_1,
                x_1_2,
                x_2_3_up
            ],
            dim=1
        )
    )

    # 128 x 128
    x_0_3 = self.x_0_3(
        torch.cat(
            [
                x_0_0,
                x_0_1,
                x_0_2,
                x_1_3
            ],
            dim=1
        )
    )

    # 128 x 128
    x_0_4 = self.x_0_4(
        torch.cat(
            [
                x_0_0,
                x_0_1,
                x_0_2,
                x_0_3,
                x_1_3
            ],
            dim=1
        )
    )

    out = self.segmentation_head(
        x_0_4
    )

    out = F.interpolate(
        out,
        size=(256, 256),
        mode="bilinear",
        align_corners=False
    )

    return out


UNetPPExact.forward = exact_forward

