# Step 10AH: build structurally pruned Swin

import torch
import torch.nn as nn

old_model = genuine_swin.to(device)
old_model.eval()

new_hidden = 208

# Create the same architecture used for the trained model
pruned_model = GenuineSwinClassifier(
    patch_dim=16,
    embed_dim=96,
    num_classes=4
).to(device)

# Replace each MLP with a 208-dimensional hidden layer
for block_idx in range(4):

    old_fc1 = old_model.blocks[block_idx].mlp[0]
    old_fc2 = old_model.blocks[block_idx].mlp[2]

    new_fc1 = nn.Linear(96, new_hidden).to(device)
    new_fc2 = nn.Linear(new_hidden, 96).to(device)

    # Hidden-neuron importance
    importance = (
        old_fc1.weight.abs().sum(dim=1) +
        old_fc2.weight.abs().sum(dim=0)
    )

    keep_idx = torch.topk(
        importance,
        k=new_hidden,
        largest=True
    ).indices

    keep_idx = torch.sort(keep_idx).values

    # Transfer selected neurons
    new_fc1.weight.data.copy_(
        old_fc1.weight.data[keep_idx, :]
    )
    new_fc1.bias.data.copy_(
        old_fc1.bias.data[keep_idx]
    )

    new_fc2.weight.data.copy_(
        old_fc2.weight.data[:, keep_idx]
    )
    new_fc2.bias.data.copy_(
        old_fc2.bias.data
    )

    pruned_model.blocks[block_idx].mlp = nn.Sequential(
        new_fc1,
        nn.GELU(),
        new_fc2
    )

# Copy all non-MLP parameters from the trained model
pruned_state = pruned_model.state_dict()
old_state = old_model.state_dict()

for name in pruned_state:
    if ".mlp." not in name and name in old_state:
        if pruned_state[name].shape == old_state[name].shape:
            pruned_state[name] = old_state[name].clone()

pruned_model.load_state_dict(pruned_state)

old_params = sum(p.numel() for p in old_model.parameters())
new_params = sum(p.numel() for p in pruned_model.parameters())

reduction = (old_params - new_params) / old_params * 100

print("Structured pruning")
print("------------------")
print(f"Original parameters : {old_params:,}")
print(f"Pruned parameters   : {new_params:,}")
print(f"Reduction           : {reduction:.2f}%")

x_check = X_test_swin[:4].to(device)

with torch.no_grad():
    y_check = pruned_model(x_check)

print()
print("Forward check")
print("-------------")
print(f"Input shape  : {tuple(x_check.shape)}")
print(f"Output shape : {tuple(y_check.shape)}")
print(f"Finite output: {torch.isfinite(y_check).all().item()}")


