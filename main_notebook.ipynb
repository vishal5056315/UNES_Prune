# =========================================================

import os
import gc
import numpy as np
import pandas as pd
import torch
from torch.utils.data import DataLoader
from tqdm.auto import tqdm

# ---------------------------------------------------------
# PATHS
# ---------------------------------------------------------
BASE_DIR = (
    "/kaggle/working/"
    "UNES_Prune_9600_EfficientNetV2"
)

MODEL_INPUT_MANIFEST = (
    "/kaggle/working/"
    "UNES_Prune_9600_ModelInput/"
    "model_input_manifest.csv"
)

FEATURE_DIR = os.path.join(
    BASE_DIR,
    "extracted_features"
)

os.makedirs(
    FEATURE_DIR,
    exist_ok=True
)

BEST_MODEL_PATH = os.path.join(
    BASE_DIR,
    "models",
    "EfficientNetV2_S_1536_best.pth"
)

# ---------------------------------------------------------
# LOAD MANIFEST
# ---------------------------------------------------------
manifest = pd.read_csv(
    MODEL_INPUT_MANIFEST
)

print("=" * 75)
print("STEP 8B — 1536-D FEATURE EXTRACTION")
print("=" * 75)

print(
    f"Total images to process: {len(manifest)}"
)

# ---------------------------------------------------------
# VERIFY EXPECTED DATASET
# ---------------------------------------------------------
assert len(manifest) == 9600

print("\nDataset:")
print(
    manifest["split"].value_counts()
)

print("\nClasses:")
print(
    manifest["class"].value_counts()
)

# ---------------------------------------------------------
# VERIFY MODEL
# ---------------------------------------------------------
print("\nLoading best EfficientNetV2-S...")

best_checkpoint = torch.load(
    BEST_MODEL_PATH,
    map_location=device
)

best_model = EfficientNetV2_S_1536().to(device)

best_model.load_state_dict(
    best_checkpoint["model_state_dict"]
)

best_model.eval()

print(
    "Best checkpoint epoch:",
    best_checkpoint["epoch"]
)

print(
    "Feature dimension:",
    FEATURE_DIM
)

# ---------------------------------------------------------
# FEATURE EXTRACTION
# ---------------------------------------------------------
print("\nStarting feature extraction...")
print("This may take several minutes.\n")

all_features = []
all_records = []

processed = 0

# Use existing dataset class
full_dataset = SegmentedMRIDataset(
    manifest
)

feature_loader = DataLoader(
    full_dataset,
    batch_size=32,
    shuffle=False,
    num_workers=2,
    pin_memory=True
)

with torch.no_grad():

    progress_bar = tqdm(
        feature_loader,
        total=len(feature_loader),
        desc="Extracting features",
        unit="batch"
    )

    for batch_idx, (images, labels) in enumerate(
        progress_bar
    ):

        images = images.to(
            device,
            non_blocking=True
        )

        # -------------------------------------------------
        # Forward pass
        # -------------------------------------------------
        logits, features = best_model(
            images
        )

        # -------------------------------------------------
        # Move features to CPU
        # -------------------------------------------------
        batch_features = (
            features
            .detach()
            .cpu()
            .numpy()
        )

        all_features.append(
            batch_features
        )

        # -------------------------------------------------
        # Get corresponding manifest rows
        # -------------------------------------------------
        start_idx = processed
        end_idx = processed + len(labels)

        batch_rows = manifest.iloc[
            start_idx:end_idx
        ].copy()

        # Store class indices
        batch_rows["label"] = labels.numpy()

        all_records.append(
            batch_rows
        )

        processed = end_idx

        # -------------------------------------------------
        # Progress information
        # -------------------------------------------------
        percentage = (
            processed /
            len(manifest) *
            100
        )

        progress_bar.set_postfix(
            images=f"{processed}/{len(manifest)}",
            percent=f"{percentage:.1f}%"
        )

        del images
        del labels
        del logits
        del features

# ---------------------------------------------------------
# COMBINE FEATURES
# ---------------------------------------------------------
print("\nCombining extracted features...")

features_array = np.concatenate(
    all_features,
    axis=0
)

feature_records = pd.concat(
    all_records,
    ignore_index=True
)

# ---------------------------------------------------------
# VERIFY SHAPE
# ---------------------------------------------------------
print("\nFeature matrix:")
print(
    "Shape:",
    features_array.shape
)

print(
    "Expected:",
    (9600, 1536)
)

assert features_array.shape == (
    9600,
    1536
)

assert len(feature_records) == 9600

# ---------------------------------------------------------
# FINITE-VALUE CHECK
# ---------------------------------------------------------
finite_check = np.isfinite(
    features_array
).all()

print(
    "All feature values finite:",
    finite_check
)

assert finite_check

# ---------------------------------------------------------
# FEATURE STATISTICS
# ---------------------------------------------------------
print("\nFeature statistics:")

print(
    "Minimum :",
    features_array.min()
)

print(
    "Maximum :",
    features_array.max()
)

print(
    "Mean    :",
    features_array.mean()
)

print(
    "Std     :",
    features_array.std()
)

# ---------------------------------------------------------
# SAVE COMPLETE FEATURE MATRIX
# ---------------------------------------------------------
feature_matrix_path = os.path.join(
    FEATURE_DIR,
    "EfficientNetV2_1536D_features.npy"
)

np.save(
    feature_matrix_path,
    features_array
)

# ---------------------------------------------------------
# SAVE FEATURE METADATA
# ---------------------------------------------------------
metadata_path = os.path.join(
    FEATURE_DIR,
    "EfficientNetV2_feature_metadata.csv"
)

feature_records.to_csv(
    metadata_path,
    index=False
)

# ---------------------------------------------------------
# SAVE SEPARATE TRAIN / VALIDATION / TEST FEATURES
# ---------------------------------------------------------
print("\nSaving split-wise features...")

for split_name in [
    "train",
    "validation",
    "test"
]:

    split_mask = (
        feature_records["split"] ==
        split_name
    )

    split_features = features_array[
        split_mask.values
    ]

    split_labels = feature_records.loc[
        split_mask,
        "label"
    ].to_numpy()

    split_classes = feature_records.loc[
        split_mask,
        "class"
    ].to_numpy()

    split_output = os.path.join(
        FEATURE_DIR,
        f"EfficientNetV2_1536D_{split_name}.npz"
    )

    np.savez_compressed(
        split_output,
        features=split_features,
        labels=split_labels,
        classes=split_classes
    )

    print(
        f"{split_name:12s}: "
        f"{split_features.shape}"
    )

# ---------------------------------------------------------
# SAVE EXTRACTION SUMMARY
# ---------------------------------------------------------
summary_path = os.path.join(
    FEATURE_DIR,
    "feature_extraction_summary.txt"
)

with open(
    summary_path,
    "w"
) as f:

    f.write(
        "EfficientNetV2-S Feature Extraction Summary\n"
    )

    f.write(
        "===========================================\n"
    )

    f.write(
        f"Checkpoint epoch: "
        f"{best_checkpoint['epoch']}\n"
    )

    f.write(
        f"Architecture: "
        f"EfficientNetV2-S\n"
    )

    f.write(
        f"Feature dimension: "
        f"{FEATURE_DIM}\n"
    )

    f.write(
        f"Total images: "
        f"{len(manifest)}\n"
    )

    f.write(
        f"Feature matrix shape: "
        f"{features_array.shape}\n"
    )

    f.write(
        f"Train images: "
        f"{(feature_records['split'] == 'train').sum()}\n"
    )

    f.write(
        f"Validation images: "
        f"{(feature_records['split'] == 'validation').sum()}\n"
    )

    f.write(
        f"Test images: "
        f"{(feature_records['split'] == 'test').sum()}\n"
    )

    f.write(
        f"All finite: "
        f"{finite_check}\n"
    )

# ---------------------------------------------------------
# CLEANUP
# ---------------------------------------------------------
del all_features
del all_records
del features_array
del feature_records
del full_dataset
del feature_loader
del best_model
del best_checkpoint

gc.collect()
torch.cuda.empty_cache()

# ---------------------------------------------------------
# FINAL
# ---------------------------------------------------------
print("\n" + "=" * 75)
print("STEP 8B COMPLETED SUCCESSFULLY")
print("=" * 75)

print("All 9,600 images processed.")
print("Feature dimension: 1,536")
print("Train: 8,000")
print("Validation: 800")
print("Test: 800")

print("\nSaved to:")
print(FEATURE_DIR)

print("=" * 75)


