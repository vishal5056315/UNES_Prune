import os
import random
import shutil
import pandas as pd
from tqdm.auto import tqdm

# =========================================================
# PATHS
# =========================================================

SOURCE_TRAIN = "/kaggle/input/datasets/rishiksaisanthosh/brain-tumour-classification/BrainTumor_1/Train"

OUTPUT_ROOT = "/kaggle/working/UNES_Prune_9600"

# =========================================================
# EXPERIMENTAL SETTINGS
# =========================================================

CLASSES = [
    "glioma",
    "meningioma",
    "pituitary",
    "notumor"
]

IMAGES_PER_CLASS = 2400

TRAIN_PER_CLASS = 2000
VAL_PER_CLASS = 200
TEST_PER_CLASS = 200

RANDOM_SEED = 42

# Reproducibility
random.seed(RANDOM_SEED)

# =========================================================
# REMOVE PREVIOUS OUTPUT IF IT EXISTS
# =========================================================

if os.path.exists(OUTPUT_ROOT):
    print("Previous output folder found.")
    print("Removing previous selection...")
    shutil.rmtree(OUTPUT_ROOT)

# =========================================================
# CREATE OUTPUT DIRECTORIES
# =========================================================

for split in ["train", "validation", "test"]:
    for cls in CLASSES:
        os.makedirs(
            os.path.join(OUTPUT_ROOT, split, cls),
            exist_ok=True
        )

print("Output directory created:")
print(OUTPUT_ROOT)

# =========================================================
# DATA RECORDS
# =========================================================

records = []

print("\n================================================")
print("SELECTING 2,400 IMAGES PER CLASS")
print("================================================\n")

# =========================================================
# PROCESS EACH CLASS
# =========================================================

for cls in CLASSES:

    class_source = os.path.join(SOURCE_TRAIN, cls)

    # Get JPG files
    files = [
        f for f in os.listdir(class_source)
        if f.lower().endswith(".jpg")
    ]

    print(f"{cls}: {len(files)} available images")

    # -----------------------------------------------------
    # Safety check
    # -----------------------------------------------------

    if len(files) < IMAGES_PER_CLASS:
        raise ValueError(
            f"Not enough images for class '{cls}'. "
            f"Required: {IMAGES_PER_CLASS}, "
            f"Available: {len(files)}"
        )

    # -----------------------------------------------------
    # Reproducible random selection
    # -----------------------------------------------------

    random.shuffle(files)

    selected_files = files[:IMAGES_PER_CLASS]

    # -----------------------------------------------------
    # Split:
    # 2000 train
    # 200 validation
    # 200 test
    # -----------------------------------------------------

    train_files = selected_files[:TRAIN_PER_CLASS]

    val_files = selected_files[
        TRAIN_PER_CLASS:
        TRAIN_PER_CLASS + VAL_PER_CLASS
    ]

    test_files = selected_files[
        TRAIN_PER_CLASS + VAL_PER_CLASS:
    ]

    split_files = {
        "train": train_files,
        "validation": val_files,
        "test": test_files
    }

    # -----------------------------------------------------
    # Copy files with progress bar
    # -----------------------------------------------------

    for split, split_file_list in split_files.items():

        destination = os.path.join(
            OUTPUT_ROOT,
            split,
            cls
        )

        for filename in tqdm(
            split_file_list,
            desc=f"{cls} → {split}",
            unit="image"
        ):

            source_file = os.path.join(
                class_source,
                filename
            )

            destination_file = os.path.join(
                destination,
                filename
            )

            shutil.copy2(
                source_file,
                destination_file
            )

            # Save record
            records.append({
                "filename": filename,
                "class": cls,
                "split": split,
                "source_path": source_file,
                "destination_path": destination_file
            })

# =========================================================
# SAVE MANIFEST
# =========================================================

manifest = pd.DataFrame(records)

manifest_path = os.path.join(
    OUTPUT_ROOT,
    "dataset_manifest.csv"
)

manifest.to_csv(
    manifest_path,
    index=False
)

# =========================================================
# FINAL SUMMARY
# =========================================================

print("\n\n================================================")
print("9,600-IMAGE COHORT CREATION COMPLETE")
print("================================================\n")

print("Total selected images:", len(manifest))

print("\nImages by split:")
print(manifest["split"].value_counts())

print("\nImages by class:")
print(manifest["class"].value_counts())

print("\nClass × Split distribution:")
print(
    pd.crosstab(
        manifest["class"],
        manifest["split"]
    )
)

print("\nManifest saved to:")
print(manifest_path)

print("\nDataset saved to:")
print(OUTPUT_ROOT)


import os
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image

# =========================================================
# PATH
# =========================================================

PREVIOUS_DATASET = "/kaggle/working/UNES_Prune_9600"

# Select a few images from the training set
sample_classes = [
    "glioma",
    "meningioma",
    "pituitary",
    "notumor"
]

# =========================================================
# COLLECT 2 IMAGES PER CLASS
# =========================================================

sample_paths = []

for cls in sample_classes:

    class_path = os.path.join(
        PREVIOUS_DATASET,
        "train",
        cls
    )

    files = sorted([
        f for f in os.listdir(class_path)
        if f.lower().endswith(".jpg")
    ])

    # First two images from each class
    for filename in files[:2]:
        sample_paths.append(
            os.path.join(class_path, filename)
        )

# =========================================================
# PREPROCESSING FUNCTION
# =========================================================

def preprocess_image(image_path):

    # Read original image
    with Image.open(image_path) as img:

        original_size = img.size
        original_mode = img.mode

        # -------------------------------------------------
        # Convert to grayscale
        # -------------------------------------------------

        gray_img = img.convert("L")

        # -------------------------------------------------
        # Resize to 256 × 256
        # -------------------------------------------------

        resized_img = gray_img.resize(
            (256, 256),
            Image.Resampling.BILINEAR
        )

        # -------------------------------------------------
        # Convert to NumPy array
        # -------------------------------------------------

        image_array = np.asarray(
            resized_img,
            dtype=np.float32
        )

        # -------------------------------------------------
        # Normalize 0–255 → 0–1
        # -------------------------------------------------

        normalized_img = image_array / 255.0

    return (
        original_mode,
        original_size,
        normalized_img
    )

# =========================================================
# DISPLAY RESULTS
# =========================================================

fig, axes = plt.subplots(
    len(sample_paths),
    2,
    figsize=(10, 4 * len(sample_paths))
)

for i, image_path in enumerate(sample_paths):

    original_mode, original_size, processed = preprocess_image(
        image_path
    )

    # -----------------------------------------------------
    # Original image
    # -----------------------------------------------------

    with Image.open(image_path) as original:
        original_display = original.copy()

    # -----------------------------------------------------
    # Display original
    # -----------------------------------------------------

    axes[i, 0].imshow(
        original_display,
        cmap="gray"
    )

    axes[i, 0].set_title(
        f"Original\n"
        f"{os.path.basename(image_path)}\n"
        f"Size: {original_size} | Mode: {original_mode}"
    )

    axes[i, 0].axis("off")

    # -----------------------------------------------------
    # Display processed
    # -----------------------------------------------------

    axes[i, 1].imshow(
        processed,
        cmap="gray",
        vmin=0,
        vmax=1
    )

    axes[i, 1].set_title(
        f"Processed\n"
        f"Size: {processed.shape}\n"
        f"Range: {processed.min():.4f}–{processed.max():.4f}"
    )

    axes[i, 1].axis("off")

plt.tight_layout()
plt.show()


import os
import numpy as np
from PIL import Image
from tqdm.auto import tqdm
import pandas as pd

# =========================================================
# PATHS
# =========================================================

SOURCE_ROOT = "/kaggle/working/UNES_Prune_9600"

OUTPUT_ROOT = "/kaggle/working/UNES_Prune_9600_Preprocessed"

# =========================================================
# SETTINGS
# =========================================================

SPLITS = [
    "train",
    "validation",
    "test"
]

CLASSES = [
    "glioma",
    "meningioma",
    "pituitary",
    "notumor"
]

TARGET_SIZE = (256, 256)

# =========================================================
# CREATE OUTPUT DIRECTORIES
# =========================================================

for split in SPLITS:
    for cls in CLASSES:

        output_dir = os.path.join(
            OUTPUT_ROOT,
            split,
            cls
        )

        os.makedirs(
            output_dir,
            exist_ok=True
        )

print("Output directory:")
print(OUTPUT_ROOT)

# =========================================================
# COLLECT ALL INPUT IMAGES
# =========================================================

image_jobs = []

for split in SPLITS:

    for cls in CLASSES:

        source_dir = os.path.join(
            SOURCE_ROOT,
            split,
            cls
        )

        files = [
            f for f in os.listdir(source_dir)
            if f.lower().endswith(".jpg")
        ]

        for filename in files:

            image_jobs.append({
                "source": os.path.join(
                    source_dir,
                    filename
                ),
                "split": split,
                "class": cls,
                "filename": filename
            })

print("\nTotal images to preprocess:", len(image_jobs))

# =========================================================
# PREPROCESS ALL 9,600 IMAGES
# =========================================================

processed_records = []
failed_records = []

min_value = float("inf")
max_value = float("-inf")

print("\n================================================")
print("STARTING PREPROCESSING")
print("================================================\n")

for job in tqdm(
    image_jobs,
    total=len(image_jobs),
    desc="Preprocessing images",
    unit="image"
):

    source_path = job["source"]

    split = job["split"]
    cls = job["class"]
    filename = job["filename"]

    try:

        # -------------------------------------------------
        # 1. Read image
        # -------------------------------------------------

        with Image.open(source_path) as img:

            # -------------------------------------------------
            # 2. Convert RGB / other modes to grayscale
            # -------------------------------------------------

            gray_img = img.convert("L")

            # -------------------------------------------------
            # 3. Resize to 256 × 256
            # -------------------------------------------------

            resized_img = gray_img.resize(
                TARGET_SIZE,
                Image.Resampling.BILINEAR
            )

            # -------------------------------------------------
            # 4. Convert to floating point
            # -------------------------------------------------

            image_array = np.asarray(
                resized_img,
                dtype=np.float32
            )

            # -------------------------------------------------
            # 5. Normalize 0–255 → 0–1
            # -------------------------------------------------

            normalized = image_array / 255.0

            # Track global normalized range
            min_value = min(
                min_value,
                float(normalized.min())
            )

            max_value = max(
                max_value,
                float(normalized.max())
            )

            # -------------------------------------------------
            # 6. Convert back to 8-bit for lossless PNG storage
            # -------------------------------------------------
            #
            # The PNG stores the processed grayscale image.
            # Normalization to [0,1] will be applied again when
            # loading the images for model training.
            #
            # -------------------------------------------------

            output_array = np.clip(
                normalized * 255.0,
                0,
                255
            ).astype(np.uint8)

            output_image = Image.fromarray(
                output_array,
                mode="L"
            )

        # -------------------------------------------------
        # 7. Output path
        # -------------------------------------------------

        output_filename = os.path.splitext(
            filename
        )[0] + ".png"

        output_path = os.path.join(
            OUTPUT_ROOT,
            split,
            cls,
            output_filename
        )

        # -------------------------------------------------
        # 8. Save lossless PNG
        # -------------------------------------------------

        output_image.save(
            output_path,
            format="PNG"
        )

        # -------------------------------------------------
        # 9. Record processing information
        # -------------------------------------------------

        processed_records.append({
            "original_filename": filename,
            "processed_filename": output_filename,
            "class": cls,
            "split": split,
            "original_path": source_path,
            "processed_path": output_path,
            "output_size": "256x256",
            "output_mode": "L"
        })

    except Exception as e:

        failed_records.append({
            "filename": filename,
            "class": cls,
            "split": split,
            "error": str(e)
        })

# =========================================================
# SAVE PROCESSING MANIFEST
# =========================================================

processed_df = pd.DataFrame(
    processed_records
)

manifest_path = os.path.join(
    OUTPUT_ROOT,
    "preprocessing_manifest.csv"
)

processed_df.to_csv(
    manifest_path,
    index=False
)

# =========================================================
# FINAL RESULTS
# =========================================================

print("\n\n================================================")
print("PREPROCESSING COMPLETE")
print("================================================")

print("\nImages attempted :", len(image_jobs))
print("Images processed :", len(processed_records))
print("Images failed    :", len(failed_records))

print(
    f"\nNormalized pixel range observed: "
    f"{min_value:.6f} → {max_value:.6f}"
)

print("\nOutput size:")
print("256 × 256")

print("\nOutput image mode:")
print("L (single-channel grayscale)")

print("\nProcessed dataset:")
print(OUTPUT_ROOT)

print("\nManifest:")
print(manifest_path)

# =========================================================
# CLASS × SPLIT VERIFICATION
# =========================================================

if len(processed_records) > 0:

    print("\n\n========== PROCESSED DATASET DISTRIBUTION ==========\n")

    print(
        pd.crosstab(
            processed_df["class"],
            processed_df["split"]
        )
    )

# =========================================================
# ERROR REPORT
# =========================================================

if failed_records:

    failed_df = pd.DataFrame(
        failed_records
    )

    failed_path = os.path.join(
        OUTPUT_ROOT,
        "preprocessing_errors.csv"
    )

    failed_df.to_csv(
        failed_path,
        index=False
    )

    print("\nWARNING:")
    print("Some images failed during preprocessing.")
    print("Error report:")
    print(failed_path)

else:

    print("\nNo preprocessing errors detected.")


