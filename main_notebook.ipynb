        flags=re.IGNORECASE | re.DOTALL
    )

    if match:

        candidate = float(match.group(1))

        # Accuracy must be a percentage.
        if 0 < candidate <= 100:

            post_finetune_accuracy = candidate
            break

if post_finetune_accuracy is None:

    raise ValueError(
        "Post-finetuning accuracy could not be "
        "recovered automatically from the saved "
        "experiment record."
    )

print(
    "Historical post-finetuning accuracy:",
    f"{post_finetune_accuracy:.4f}%"
)

print("Progress: 70% - post-finetuning result verified")

# ============================================================
# Calculate actual parameter storage
# ============================================================

# Swin parameters are stored as float32.
BYTES_PER_PARAMETER = 4

original_size_mb = (
    original_parameters *
    BYTES_PER_PARAMETER /
    (1024 ** 2)
)

pruned_size_mb = (
    pruned_parameters *
    BYTES_PER_PARAMETER /
    (1024 ** 2)
)

print(
    "\nOriginal parameter storage:",
    f"{original_size_mb:.4f} MB"
)

print(
    "Pruned parameter storage:",
    f"{pruned_size_mb:.4f} MB"
)

print(
