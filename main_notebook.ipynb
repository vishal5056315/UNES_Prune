# ============================================================
# DATASET
# ============================================================

class BrainTumorSegmentationDataset(Dataset):

    def __init__(
        self,
        dataframe,
        training=False
    ):

        self.df = dataframe.reset_index(drop=True)
        self.training = training

    def __len__(self):

        return len(self.df)

    def __getitem__(self, idx):

        row = self.df.iloc[idx]

        # ----------------------------------------------------
        # READ MRI
        # ----------------------------------------------------

        image = np.asarray(
            Image.open(
                row["image_path"]
            ).convert("L"),
            dtype=np.float32
        )

        # ----------------------------------------------------
        # READ MASK
        # ----------------------------------------------------

        mask = np.asarray(
            Image.open(
                row["mask_path"]
            ),
            dtype=np.uint8
        )

        # ----------------------------------------------------
        # NORMALIZATION
        # ----------------------------------------------------

        image = image / 255.0

        # Binary mask
        mask = (mask > 0).astype(
            np.float32
        )

        # ----------------------------------------------------
        # BASIC AUGMENTATION
        # TRAINING ONLY
        # ----------------------------------------------------

        if self.training:

            # Horizontal flip
            if random.random() < 0.5:

                image = np.fliplr(
                    image
                ).copy()

                mask = np.fliplr(
                    mask
                ).copy()

            # Vertical flip
            if random.random() < 0.2:

                image = np.flipud(
                    image
                ).copy()

                mask = np.flipud(
                    mask
                ).copy()

        # ----------------------------------------------------
        # CHANNEL DIMENSION
        # ----------------------------------------------------

        image = np.expand_dims(
            image,
            axis=0
        )

        mask = np.expand_dims(
            mask,
            axis=0
        )

        # ----------------------------------------------------
        # TORCH
        # ----------------------------------------------------

        image = torch.from_numpy(
            image
        ).float()

        mask = torch.from_numpy(
            mask
        ).float()

        return image, mask


# ============================================================
# CREATE DATASETS
# ============================================================

train_dataset = BrainTumorSegmentationDataset(
    train_df,
    training=True
)

val_dataset = BrainTumorSegmentationDataset(
    val_df,
    training=False
)

# ============================================================
# DATA LOADERS
# ============================================================

BATCH_SIZE = 16

train_loader = DataLoader(
    train_dataset,
    batch_size=BATCH_SIZE,
    shuffle=True,
    num_workers=2,
    pin_memory=True
)

val_loader = DataLoader(
    val_dataset,
    batch_size=BATCH_SIZE,
    shuffle=False,
    num_workers=2,
    pin_memory=True
)

# ============================================================
# CHECK ONE BATCH
# ============================================================

sample_images, sample_masks = next(
    iter(train_loader)
)

print()
print("=" * 70)
print("DATA PIPELINE CHECK")
print("=" * 70)

print(
    "Image batch shape :",
    tuple(sample_images.shape)
)

print(
    "Mask batch shape  :",
    tuple(sample_masks.shape)
)

print(
    "Image min/max     :",
    float(sample_images.min()),
    float(sample_images.max())
)

print(
    "Mask unique values:",
    torch.unique(sample_masks).tolist()
)

# ============================================================
# U-NET++ MODEL
# ============================================================

model = smp.UnetPlusPlus(
    encoder_name="resnet18",
    encoder_weights=None,
    in_channels=1,
    classes=1,
    activation=None
)

model = model.to(DEVICE)

# ============================================================
# MODEL INFORMATION
# ============================================================

total_parameters = sum(
    p.numel()
    for p in model.parameters()
)

trainable_parameters = sum(
    p.numel()
    for p in model.parameters()
    if p.requires_grad
)

print()
print("=" * 70)
print("REAL U-NET++ MODEL")
print("=" * 70)

print(
    "Architecture      : U-Net++"
)

print(
    "Encoder            : ResNet-18"
)

print(
    "Input              : 256 × 256 × 1"
)

print(
    "Output             : 256 × 256 × 1"
)

print(
    "Activation         : Sigmoid during inference"
)

print(
    "Total parameters   :",
    f"{total_parameters:,}"
)

print(
    "Trainable params   :",
    f"{trainable_parameters:,}"
)

print(
    "Parameters (M)     :",
    f"{trainable_parameters / 1e6:.2f}"
)

# ============================================================
# DICE LOSS
# ============================================================

dice_loss = smp.losses.DiceLoss(
    mode="binary",
    from_logits=True
)

# ============================================================
# OPTIMIZER
# ============================================================

optimizer = torch.optim.Adam(
    model.parameters(),
    lr=1e-4
)

# ============================================================
# METRICS
# ============================================================

def calculate_dice(
    logits,
    targets,
    threshold=0.5
):

    probabilities = torch.sigmoid(
        logits
    )

    predictions = (
        probabilities > threshold
    ).float()

    predictions = predictions.contiguous()
    targets = targets.contiguous()

    intersection = (
        predictions * targets
    ).sum(dim=(1, 2, 3))

    denominator = (
        predictions.sum(dim=(1, 2, 3))
        +
        targets.sum(dim=(1, 2, 3))
    )

    dice = (
        (2.0 * intersection + 1e-7)
        /
        (denominator + 1e-7)
    )

    return dice.mean().item()


def calculate_iou(
    logits,
    targets,
    threshold=0.5
):

    probabilities = torch.sigmoid(
        logits
    )

    predictions = (
        probabilities > threshold
    ).float()

    intersection = (
        predictions * targets
    ).sum(dim=(1, 2, 3))

    union = (
        predictions.sum(dim=(1, 2, 3))
        +
        targets.sum(dim=(1, 2, 3))
        -
        intersection
    )

    iou = (
        (intersection + 1e-7)
        /
        (union + 1e-7)
    )

    return iou.mean().item()

# ============================================================
# TRAINING SETTINGS
# ============================================================

EPOCHS = 20

best_val_dice = -1.0

history = {
    "epoch": [],
    "train_loss": [],
    "train_dice": [],
    "train_iou": [],
    "val_loss": [],
    "val_dice": [],
    "val_iou": []
}

# ============================================================
# TRAINING LOOP
# ============================================================

print()
print("=" * 70)
print("STARTING U-NET++ TRAINING")
print("=" * 70)

for epoch in range(1, EPOCHS + 1):

    # ========================================================
    # TRAIN
    # ========================================================

    model.train()

    running_loss = 0.0
    running_dice = 0.0
    running_iou = 0.0

    for images, masks in train_loader:

        images = images.to(
            DEVICE,
            non_blocking=True
        )

        masks = masks.to(
            DEVICE,
            non_blocking=True
        )

        optimizer.zero_grad(
            set_to_none=True
        )

        logits = model(images)

        loss = dice_loss(
            logits,
            masks
        )

        loss.backward()

        optimizer.step()

        running_loss += (
            loss.item()
        )

        running_dice += (
            calculate_dice(
                logits.detach(),
                masks
            )
        )

        running_iou += (
            calculate_iou(
                logits.detach(),
                masks
            )
        )

    train_loss = (
        running_loss /
        len(train_loader)
    )

    train_dice = (
        running_dice /
        len(train_loader)
    )

    train_iou = (
        running_iou /
        len(train_loader)
    )

    # ========================================================
    # VALIDATION
    # ========================================================

    model.eval()

    val_running_loss = 0.0
    val_running_dice = 0.0
    val_running_iou = 0.0

    with torch.no_grad():

        for images, masks in val_loader:

            images = images.to(
                DEVICE,
                non_blocking=True
            )

            masks = masks.to(
                DEVICE,
                non_blocking=True
            )

            logits = model(images)

            loss = dice_loss(
                logits,
                masks
            )

            val_running_loss += (
                loss.item()
            )

            val_running_dice += (
                calculate_dice(
                    logits,
                    masks
                )
            )

            val_running_iou += (
                calculate_iou(
                    logits,
                    masks
                )
            )

    val_loss = (
        val_running_loss /
        len(val_loader)
    )

    val_dice = (
        val_running_dice /
        len(val_loader)
    )

    val_iou = (
        val_running_iou /
        len(val_loader)
    )

    # ========================================================
    # SAVE HISTORY
    # ========================================================

    history["epoch"].append(epoch)

    history["train_loss"].append(
        train_loss
    )

    history["train_dice"].append(
        train_dice
    )

    history["train_iou"].append(
        train_iou
    )

    history["val_loss"].append(
        val_loss
    )

    history["val_dice"].append(
        val_dice
    )

    history["val_iou"].append(
        val_iou
    )

    # ========================================================
    # SAVE BEST MODEL
    # ========================================================

    if val_dice > best_val_dice:

        best_val_dice = val_dice

        best_model_path = os.path.join(
            MODEL_DIR,
            "UNES_Prune_UNetPP_best.pth"
        )

        torch.save(
            {
                "epoch": epoch,
                "model_state_dict":
                    model.state_dict(),
                "optimizer_state_dict":
                    optimizer.state_dict(),
                "val_dice":
                    val_dice,
                "val_iou":
                    val_iou
            },
            best_model_path
        )

        best_marker = "  <-- BEST"

    else:

        best_marker = ""

    # ========================================================
    # PRINT
    # ========================================================

    print(
        f"Epoch {epoch:02d}/{EPOCHS} | "
        f"Train Loss: {train_loss:.4f} | "
        f"Train Dice: {train_dice:.4f} | "
        f"Train IoU: {train_iou:.4f} | "
        f"Val Loss: {val_loss:.4f} | "
        f"Val Dice: {val_dice:.4f} | "
        f"Val IoU: {val_iou:.4f}"
        f"{best_marker}"
    )

# ============================================================
# SAVE FINAL MODEL
# ============================================================

final_model_path = os.path.join(
    MODEL_DIR,
    "UNES_Prune_UNetPP_final.pth"
)

torch.save(
    model.state_dict(),
    final_model_path
)

# ============================================================
# SAVE HISTORY
# ============================================================

history_df = pd.DataFrame(
    history
)

history_path = os.path.join(
    RESULT_DIR,
    "UNetPP_training_history.csv"
)

history_df.to_csv(
    history_path,
    index=False
)

# ============================================================
# PLOT DICE
# ============================================================

plt.figure(figsize=(9, 6))

plt.plot(
    history["epoch"],
    history["train_dice"],
    marker="o",
    label="Training Dice"
)

plt.plot(
    history["epoch"],
    history["val_dice"],
    marker="o",
    label="Validation Dice"
)

plt.xlabel("Epoch")
plt.ylabel("Dice Coefficient")
plt.title("U-Net++ Dice Coefficient vs Epochs")
plt.legend()
plt.grid(True)
plt.tight_layout()

dice_plot_path = os.path.join(
    RESULT_DIR,
