    genuine_swin.train()

    train_loss = 0.0
    train_correct = 0
    train_total = 0

    total_train_batches = len(
        train_loader_swin
    )

    for batch_idx, (images, targets) in enumerate(
        train_loader_swin,
        start=1
    ):

        images = images.to(
            device,
            non_blocking=True
        )

        targets = targets.to(
            device,
            non_blocking=True
        )

        optimizer_swin.zero_grad(
            set_to_none=True
        )

        logits = genuine_swin(images)

        loss = criterion_swin(
            logits,
            targets
        )

        loss.backward()

        optimizer_swin.step()

        train_loss += (
            loss.item() * targets.size(0)
        )

        predictions = logits.argmax(
            dim=1
        )

        train_correct += (
            predictions == targets
        ).sum().item()

        train_total += targets.size(0)

        progress = (
            batch_idx
            / total_train_batches
            * 100
        )

        if (
            batch_idx == 1
            or batch_idx % 25 == 0
            or batch_idx == total_train_batches
        ):
