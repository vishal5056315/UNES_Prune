    (pruned_time - original_time)
    / original_time
    * 100
)

print()
print(f"Latency change          : {time_change:+.2f}%")

if pruned_time < original_time:
    latency_reduction = (
        (original_time - pruned_time)
        / original_time
        * 100
    )
    print(f"Latency reduction       : {latency_reduction:.2f}%")
else:
