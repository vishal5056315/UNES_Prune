class SegmentedMRIClassificationDataset(Dataset):

    def __init__(
        self,
        dataframe
    ):

        self.df = dataframe.reset_index(
            drop=True
        )

    def __len__(self):

        return len(self.df)

    def __getitem__(self, idx):

        row = self.df.iloc[idx]

        image_path = row[
            "segmented_image_path"
        ]

        image = Image.open(
            image_path
        ).convert("L")

        # Convert grayscale MRI to three identical
        # channels because EfficientNetV2 expects RGB.
        image = image.convert("RGB")

        image = transforms.functional.to_tensor(
            image
        )

        # Match ImageNet pretrained-model normalization.
        image = transforms.functional.normalize(
            image,
            mean=[
                0.485,
                0.456,
                0.406
            ],
            std=[
                0.229,
                0.224,
                0.225
            ]
        )

        label = int(
            row["label"]
        )

        return image, label


