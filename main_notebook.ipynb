    )

print("\nZERO CROSS-SPLIT EXACT DUPLICATES CONFIRMED.")

# ---------------------------------------------------------------------------
# STEP 7 — SAVE CLEAN MANIFEST
# ---------------------------------------------------------------------------
clean_manifest = os.path.join(
    OUTPUT_ROOT,
    "clean_dataset_manifest.csv"
)

clean_df.to_csv(
    clean_manifest,
    index=False
)

# ---------------------------------------------------------------------------
# STEP 8 — COPY IMAGES INTO CLEAN DIRECTORY
# ---------------------------------------------------------------------------
print("\n" + "-" * 75)
print("STEP 8 — COPYING CLEAN DATASET")
print("-" * 75)

for split in ["train", "validation", "test"]:

    for class_name in CLASSES:

        destination = os.path.join(
            OUTPUT_ROOT,
