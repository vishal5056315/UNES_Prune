import pandas as pd
import torch
import torch.nn as nn
from tqdm.auto import tqdm
from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score
)

# ---------------------------------------------------------
# SETTINGS
# ---------------------------------------------------------
TOTAL_EPOCHS = 20

START_EPOCH = checkpoint["epoch"] + 1

BASE_DIR = "/kaggle/working/UNES_Prune_9600_EfficientNetV2"

MODEL_DIR = os.path.join(BASE_DIR, "models")
RESULTS_DIR = os.path.join(BASE_DIR, "training_results")
RESUME_DIR = os.path.join(BASE_DIR, "resume_checkpoint")

os.makedirs(MODEL_DIR, exist_ok=True)
os.makedirs(RESULTS_DIR, exist_ok=True)
os.makedirs(RESUME_DIR, exist_ok=True)

best_model_path = os.path.join(
    MODEL_DIR,
    "EfficientNetV2_S_1536_best.pth"
)

history_csv = os.path.join(
    RESULTS_DIR,
    "EfficientNetV2_training_history.csv"
)

criterion = nn.CrossEntropyLoss()

# ---------------------------------------------------------
# FIND PREVIOUS BEST VALIDATION ACCURACY
# ---------------------------------------------------------
previous_best_val_accuracy = 0.0

for row in history:

    if "val_accuracy" in row:

        value = float(row["val_accuracy"])

        if value > previous_best_val_accuracy:
            previous_best_val_accuracy = value

# ---------------------------------------------------------
# TRAINING FUNCTIONS
# ---------------------------------------------------------
def train_one_epoch(
    model,
    loader,
    optimizer,
    criterion,
    device
):

    model.train()

    running_loss = 0.0

    all_predictions = []
    all_labels = []

    progress_bar = tqdm(
        loader,
        desc="Training",
        leave=True
    )

    for images, labels in progress_bar:

        images = images.to(
            device,
            non_blocking=True
        )

        labels = labels.to(
            device,
            non_blocking=True
        )

        optimizer.zero_grad(
            set_to_none=True
        )

        logits, features = model(images)

        loss = criterion(
            logits,
            labels
        )

        loss.backward()

        optimizer.step()

        running_loss += (
            loss.item() * images.size(0)
        )

        predictions = torch.argmax(
            logits,
            dim=1
        )

        all_predictions.extend(
            predictions.detach().cpu().numpy()
        )

        all_labels.extend(
            labels.detach().cpu().numpy()
        )

        progress_bar.set_postfix(
            loss=f"{loss.item():.4f}"
        )

    epoch_loss = (
        running_loss /
        len(loader.dataset)
    )

    epoch_accuracy = accuracy_score(
        all_labels,
        all_predictions
    )

    epoch_precision = precision_score(
        all_labels,
        all_predictions,
        average="macro",
        zero_division=0
    )

    epoch_recall = recall_score(
        all_labels,
        all_predictions,
        average="macro",
        zero_division=0
    )

    epoch_f1 = f1_score(
        all_labels,
        all_predictions,
        average="macro",
        zero_division=0
    )

    return (
        epoch_loss,
        epoch_accuracy,
        epoch_precision,
        epoch_recall,
        epoch_f1
    )


def validate_one_epoch(
    model,
    loader,
    criterion,
    device
):

    model.eval()

    running_loss = 0.0

    all_predictions = []
    all_labels = []

    progress_bar = tqdm(
        loader,
        desc="Validation",
        leave=True
    )

    with torch.no_grad():

        for images, labels in progress_bar:

            images = images.to(
                device,
                non_blocking=True
            )

            labels = labels.to(
                device,
                non_blocking=True
            )

            logits, features = model(images)

            loss = criterion(
                logits,
                labels
            )

            running_loss += (
                loss.item() * images.size(0)
            )

            predictions = torch.argmax(
                logits,
                dim=1
            )

            all_predictions.extend(
                predictions.cpu().numpy()
            )

            all_labels.extend(
                labels.cpu().numpy()
            )

            progress_bar.set_postfix(
                loss=f"{loss.item():.4f}"
            )

    epoch_loss = (
        running_loss /
        len(loader.dataset)
    )

    epoch_accuracy = accuracy_score(
        all_labels,
        all_predictions
    )

    epoch_precision = precision_score(
        all_labels,
        all_predictions,
        average="macro",
        zero_division=0
    )

    epoch_recall = recall_score(
        all_labels,
        all_predictions,
        average="macro",
        zero_division=0
    )

    epoch_f1 = f1_score(
        all_labels,
        all_predictions,
        average="macro",
        zero_division=0
    )

    return (
        epoch_loss,
        epoch_accuracy,
        epoch_precision,
        epoch_recall,
        epoch_f1
    )


# =========================================================
# SAFETY CHECK
# =========================================================
print("=" * 70)
print("EFFICIENTNETV2-S — RESUME TRAINING")
print("=" * 70)

print(f"Last completed epoch : {checkpoint['epoch']}")
print(f"Starting epoch       : {START_EPOCH}")
print(f"Final epoch          : {TOTAL_EPOCHS}")
print(
    f"Remaining epochs     : "
    f"{TOTAL_EPOCHS - checkpoint['epoch']}"
)
print(f"Batch size           : {BATCH_SIZE}")
print(
    f"Learning rate        : "
    f"{optimizer.param_groups[0]['lr']}"
)
print(f"Device               : {device}")
print(
    f"Previous best val acc: "
    f"{previous_best_val_accuracy:.4f}"
)

# ---------------------------------------------------------
# SAFETY: DO NOT TRAIN IF ALREADY COMPLETE
# ---------------------------------------------------------
if START_EPOCH > TOTAL_EPOCHS:

    print("\nTraining is already complete.")
    print(
        f"Last completed epoch: "
        f"{checkpoint['epoch']}"
    )

else:

    # =====================================================
    # TRAIN EPOCHS 13 -> 20
    # =====================================================

    for epoch in range(
        START_EPOCH,
        TOTAL_EPOCHS + 1
    ):

        epoch_start_time = time.time()

        print("\n")
        print("=" * 70)
        print(
            f"EPOCH {epoch}/{TOTAL_EPOCHS}"
        )
        print("=" * 70)

        # -------------------------------------------------
        # TRAIN
        # -------------------------------------------------
        (
            train_loss,
            train_accuracy,
            train_precision,
            train_recall,
            train_f1
        ) = train_one_epoch(
            model,
            train_loader,
            optimizer,
            criterion,
            device
        )

        # -------------------------------------------------
        # VALIDATION
        # -------------------------------------------------
        (
            val_loss,
            val_accuracy,
            val_precision,
            val_recall,
            val_f1
        ) = validate_one_epoch(
            model,
            val_loader,
            criterion,
            device
        )

        epoch_time = (
            time.time() -
            epoch_start_time
        )

        # -------------------------------------------------
        # ADD TO HISTORY
        # -------------------------------------------------
        history.append({

            "epoch": epoch,

            "train_loss": train_loss,
            "train_accuracy": train_accuracy,
            "train_precision": train_precision,
            "train_recall": train_recall,
            "train_f1": train_f1,

            "val_loss": val_loss,
            "val_accuracy": val_accuracy,
            "val_precision": val_precision,
            "val_recall": val_recall,
            "val_f1": val_f1,

            "epoch_time_seconds": epoch_time
        })

        # -------------------------------------------------
        # PRINT RESULTS
        # -------------------------------------------------
        print("\nEpoch Results")
        print("-" * 70)

        print(
            f"Train | "
            f"Loss: {train_loss:.4f} | "
            f"Acc: {train_accuracy:.4f} | "
            f"Precision: {train_precision:.4f} | "
            f"Recall: {train_recall:.4f} | "
            f"F1: {train_f1:.4f}"
        )

        print(
            f"Val   | "
            f"Loss: {val_loss:.4f} | "
            f"Acc: {val_accuracy:.4f} | "
            f"Precision: {val_precision:.4f} | "
            f"Recall: {val_recall:.4f} | "
            f"F1: {val_f1:.4f}"
        )

        print(
            f"Epoch time: "
            f"{epoch_time / 60:.2f} minutes"
        )

        # -------------------------------------------------
        # SAVE COMPLETE HISTORY
        # -------------------------------------------------
        history_df = pd.DataFrame(history)

        history_df.to_csv(
            history_csv,
            index=False
        )

        # -------------------------------------------------
        # SAVE BEST MODEL
        # -------------------------------------------------
        if val_accuracy > previous_best_val_accuracy:

            previous_best_val_accuracy = val_accuracy

            torch.save(
                {
                    "epoch": epoch,
                    "model_state_dict":
                        model.state_dict(),
                    "optimizer_state_dict":
                        optimizer.state_dict(),
                    "val_accuracy":
                        val_accuracy,
                    "val_f1":
                        val_f1,
                    "feature_dimension":
                        FEATURE_DIM,
                    "num_classes":
                        NUM_CLASSES,
                    "architecture":
                        "EfficientNetV2-S"
                },
                best_model_path
            )

            print(
                "\n*** NEW BEST MODEL SAVED ***"
            )

            print(
                f"Best validation accuracy: "
                f"{val_accuracy:.4f}"
            )

        # -------------------------------------------------
        # SAVE RESUME CHECKPOINT
        # -------------------------------------------------
        resume_path = os.path.join(
            RESUME_DIR,
            f"EfficientNetV2_S_resume_epoch{epoch}.pth"
        )

        torch.save(
            {
                "epoch": epoch,
                "model_state_dict":
                    model.state_dict(),
                "optimizer_state_dict":
                    optimizer.state_dict(),
                "history": history,
                "feature_dimension":
                    FEATURE_DIM,
                "num_classes":
                    NUM_CLASSES,
                "batch_size":
                    BATCH_SIZE,
                "learning_rate":
                    optimizer.param_groups[0]["lr"],
                "architecture":
                    "EfficientNetV2-S",
                "seed":
                    checkpoint.get("seed", None)
            },
            resume_path
        )

        print(
            f"✓ Resume checkpoint saved: "
            f"epoch {epoch}"
        )

        # -------------------------------------------------
        # SAVE A SMALL CSV FOR THIS CHECKPOINT
        # -------------------------------------------------
        checkpoint_history_csv = os.path.join(
            RESUME_DIR,
            f"EfficientNetV2_training_history_epoch{epoch}.csv"
        )

        history_df.to_csv(
            checkpoint_history_csv,
            index=False
        )

        # -------------------------------------------------
        # GPU CLEANUP
        # -------------------------------------------------
        torch.cuda.empty_cache()

    # =====================================================
    # FINAL MESSAGE
    # =====================================================

    print("\n")
    print("=" * 70)
    print("TRAINING COMPLETE")
    print("=" * 70)

    print(
        f"Completed through epoch: "
        f"{TOTAL_EPOCHS}"
    )

    print(
        f"Best validation accuracy: "
        f"{previous_best_val_accuracy:.4f}"
    )

    print("\nBest model:")
    print(best_model_path)

    print("\nTraining history:")
    print(history_csv)

    print("\nResume checkpoints:")
    print(RESUME_DIR)

    print("=" * 70)


