# ImageNet-pretrained EfficientNetV2-S.
weights = models.EfficientNet_V2_S_Weights.DEFAULT

backbone = models.efficientnet_v2_s(
    weights=weights
)

# Replace the original classifier.
# EfficientNetV2-S backbone feature dimension = 1280.
backbone.classifier = nn.Identity()

feature_extractor = backbone

# Learned 1536-D representation + four-class classifier.
class EfficientNetV2_S_Pretrained_1536(
    nn.Module
):

    def __init__(self):

        super().__init__()

        self.backbone = feature_extractor

        self.feature_projection = nn.Sequential(
            nn.Linear(
                1280,
                1536
            ),
            nn.BatchNorm1d(1536),
            nn.ReLU(inplace=True),
            nn.Dropout(0.2)
        )

        self.classifier = nn.Linear(
            1536,
            4
        )

    def forward(
        self,
        x,
        return_features=False
    ):

        x = self.backbone(x)

        features = self.feature_projection(
            x
        )

        logits = self.classifier(
            features
        )

        if return_features:

            return logits, features

        return logits


model = EfficientNetV2_S_Pretrained_1536().to(
    device
)

total_params = sum(
    p.numel()
    for p in model.parameters()
)

trainable_params = sum(
    p.numel()
    for p in model.parameters()
