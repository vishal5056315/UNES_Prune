val_df = df[df["split"] == "validation"].copy()
test_df = df[df["split"] == "test"].copy()

train_dataset = EfficientNetDataset(
    train_df,
    transform=transform
)

val_dataset = EfficientNetDataset(
    val_df,
    transform=transform
)

test_dataset = EfficientNetDataset(
    test_df,
    transform=transform
)

print(f"Training records        : {len(train_dataset)}")
print(f"Validation records      : {len(val_dataset)}")
print(f"Testing records         : {len(test_dataset)}")

# Test several images from different classes
test_indices = []

for class_name in class_names:

    class_indices = train_df.index[
        train_df["class"] == class_name
    ].tolist()

    if len(class_indices) == 0:
        raise ValueError(
            f"No training images found for {class_name}"
        )

    # Convert dataframe index to dataset index
    dataset_index = train_df.index.get_loc(
        class_indices[0]
    )

    test_indices.append(dataset_index)


print("\nTesting representative images:")

for i, dataset_index in enumerate(test_indices):

    image, label = train_dataset[dataset_index]

    print(
        f"  [{i+1}/4] "
        f"class={class_names[label]:12s} | "
        f"tensor={tuple(image.shape)} | "
        f"range=({image.min().item():.4f}, "
        f"{image.max().item():.4f})"
    )


# ---------------------------------------------------------------
# [6/6] Build EfficientNetV2-S with learned 1536-D representation
# ---------------------------------------------------------------
print("\n[6/6] Building EfficientNetV2-S...")
print("-" * 60)


class EfficientNetV2_1536(nn.Module):

    def __init__(self, num_classes=4, feature_dim=1536):

        super().__init__()

        self.backbone = models.efficientnet_v2_s(
            weights=None
        )

        backbone_dim = (
            self.backbone.classifier[1].in_features
        )

        # Remove the original ImageNet classifier.
        self.backbone.classifier = nn.Identity()

        # Learned feature representation.
        self.feature_layer = nn.Linear(
            backbone_dim,
            feature_dim
        )

        # Four-class tumor classifier.
        self.classifier = nn.Linear(
            feature_dim,
            num_classes
        )

    def forward(self, x, return_features=False):

        x = self.backbone(x)

        features = self.feature_layer(x)

        logits = self.classifier(features)

        if return_features:
            return logits, features

        return logits


model = EfficientNetV2_1536(
    num_classes=NUM_CLASSES,
    feature_dim=FEATURE_DIM
).to(DEVICE)


# Parameter count
total_params = sum(
    p.numel()
    for p in model.parameters()
)

trainable_params = sum(
    p.numel()
    for p in model.parameters()
    if p.requires_grad
)

