# ============================================================
# STEP 7A — CHECK MRI / MASK PAIRS
# ============================================================

import os
import glob
import numpy as np
from PIL import Image
from collections import Counter

SEG_ROOT = "/kaggle/input/datasets/mateuszbuda/lgg-mri-segmentation"
IMG_ROOT = os.path.join(SEG_ROOT, "kaggle_3m")

patient_dirs = sorted([
    os.path.join(IMG_ROOT, d)
    for d in os.listdir(IMG_ROOT)
    if os.path.isdir(os.path.join(IMG_ROOT, d))
])

print("=" * 70)
print("MRI–MASK PAIR CHECK")
print("=" * 70)

print("Patient folders:", len(patient_dirs))

total_images = 0
valid_pairs = 0
missing_masks = 0
dimension_mismatch = 0
empty_masks = 0
nonempty_masks = 0

shapes = Counter()

# ------------------------------------------------------------
# CHECK EACH PATIENT
# ------------------------------------------------------------

for patient_dir in patient_dirs:

    files = os.listdir(patient_dir)

    for filename in files:

        # Only original MRI images
        if not filename.endswith(".tif"):
            continue

        if filename.endswith("_mask.tif"):
            continue

        total_images += 1

        image_path = os.path.join(
            patient_dir,
            filename
        )

        mask_name = filename.replace(
            ".tif",
            "_mask.tif"
        )

        mask_path = os.path.join(
            patient_dir,
            mask_name
        )

        # ----------------------------------------------------
        # MASK EXISTS?
        # ----------------------------------------------------

        if not os.path.exists(mask_path):
            missing_masks += 1
            continue

        # ----------------------------------------------------
        # READ IMAGE AND MASK
        # ----------------------------------------------------

        try:
            image = np.asarray(
                Image.open(image_path)
            )

            mask = np.asarray(
                Image.open(mask_path)
            )

        except Exception as e:
            print("Read error:", image_path)
            print(e)
            continue

        # ----------------------------------------------------
        # DIMENSION CHECK
        # ----------------------------------------------------

        if image.shape[:2] != mask.shape[:2]:

            dimension_mismatch += 1

            continue

        # ----------------------------------------------------
        # VALID PAIR
        # ----------------------------------------------------

        valid_pairs += 1

        shapes[image.shape] += 1

        # ----------------------------------------------------
        # MASK CONTENT
        # ----------------------------------------------------

        if np.max(mask) > 0:
            nonempty_masks += 1
        else:
            empty_masks += 1


# ============================================================
# FINAL RESULT
# ============================================================

print("\n" + "=" * 70)
print("RESULT")
print("=" * 70)

print("Total MRI images       :", total_images)
print("Valid MRI-mask pairs   :", valid_pairs)
print("Missing masks          :", missing_masks)
print("Dimension mismatches   :", dimension_mismatch)
print("Non-empty masks        :", nonempty_masks)
print("Empty masks            :", empty_masks)

print("\nImage dimensions:")

for shape, count in shapes.most_common():
    print(f"  {shape}: {count}")

print("\n" + "=" * 70)
print("CHECK COMPLETE")
print("=" * 70)


