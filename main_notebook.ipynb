# Step 10AW: FLOPs and inference time of the 49.37% pruned model

import time
import torch

model = pruned_model_96.to(device)
model.eval()

B = 1
N = 96
C = 96
P = 16
H = 12
W = 8
window = 4
heads = 4
head_dim = C // heads
mlp_dim = 96

flops = 0

# Patch embedding
flops += 2 * N * P * C

# Four Swin blocks
for _ in range(4):

    # QKV
    flops += 2 * N * C * (3 * C)

    # Window attention: QK^T
    windows_per_sample = (H // window) * (W // window)
    tokens_per_window = window * window

    flops += (
        2 * windows_per_sample *
        heads *
        tokens_per_window *
        tokens_per_window *
        head_dim
    )

    # Attention × V
    flops += (
        2 * windows_per_sample *
        heads *
        tokens_per_window *
        tokens_per_window *
        head_dim
    )

    # Attention projection
    flops += 2 * N * C * C

    # MLP: 96 -> 96 -> 96
    flops += 2 * N * C * mlp_dim
    flops += 2 * N * mlp_dim * C

# Final classifier
flops += 2 * C * 4

gflops = flops / 1e9

# Inference timing
x = X_test_swin[:1].to(device)

with torch.no_grad():
    for _ in range(20):
        _ = model(x)

if device.type == "cuda":
    torch.cuda.synchronize()

times = []

with torch.no_grad():
    for _ in range(100):

        if device.type == "cuda":
            torch.cuda.synchronize()

        start = time.perf_counter()

        _ = model(x)

        if device.type == "cuda":
            torch.cuda.synchronize()

        end = time.perf_counter()

        times.append(end - start)

inference_ms = sum(times) / len(times) * 1000

params = sum(p.numel() for p in model.parameters())

print("49.37% pruned model efficiency")
print("-------------------------------")
print(f"Parameters     : {params:,}")
print(f"Parameter drop : {(1 - params / 450356) * 100:.2f}%")
print(f"FLOPs          : {flops:,}")
print(f"GFLOPs         : {gflops:.6f}")
print(f"Inference time : {inference_ms:.3f} ms/image")


