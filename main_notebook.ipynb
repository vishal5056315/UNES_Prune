print(f"Hierarchical layers           : {NUM_HIERARCHICAL_LAYERS}")
print(f"Number of classes             : {NUM_CLASSES}")


# ==========================================================================
# Patch Embedding
# ==========================================================================
class FeaturePatchEmbedding(nn.Module):
    """
    Converts the 1536-D EfficientNetV2 feature vector into a
    48 × 32 feature arrangement and partitions it into 4 × 4 patches.

    48 × 32 -> 12 × 8 patches -> 96 tokens.
    Each patch contains 16 values and is linearly embedded into 96-D.
    """
    
    def __init__(
        self,
        input_dim=1536,
        height=48,
        width=32,
        patch_size=4,
        embed_dim=96
    ):
        super().__init__()

        assert height * width == input_dim
        assert height % patch_size == 0
        assert width % patch_size == 0

        self.input_dim = input_dim
        self.height = height
        self.width = width
        self.patch_size = patch_size
        self.embed_dim = embed_dim

        patch_vector_dim = patch_size * patch_size

        self.projection = nn.Linear(
            patch_vector_dim,
            embed_dim
        )

    def forward(self, x):

        # x: [B, 1536]
        B = x.shape[0]

        # Arrange feature vector as 48 × 32
        x = x.reshape(
            B,
            self.height,
            self.width
        )

        # Partition into 4 × 4 patches
        x = x.unfold(
            1,
            self.patch_size,
            self.patch_size
        ).unfold(
            2,
            self.patch_size,
            self.patch_size
        )

        # [B, 12, 8, 4, 4]
        x = x.contiguous()

        # Flatten each patch
        x = x.reshape(
            B,
            NUM_PATCHES_H,
            NUM_PATCHES_W,
            self.patch_size * self.patch_size
        )

        # [B, 96, 16]
        x = x.reshape(
            B,
            NUM_TOKENS,
            self.patch_size * self.patch_size
        )

        # Linear embedding: 16 -> 96
        x = self.projection(x)

        # [B, 96, 96]
        return x


# ==========================================================================
# Swin Transformer Block
# ==========================================================================
class SwinTransformerBlock(nn.Module):

    def __init__(
        self,
        dim,
        num_heads,
        window_size=4,
        shift_size=0,
        mlp_ratio=4.0,
        dropout=0.0
    ):
        super().__init__()

        self.dim = dim
        self.num_heads = num_heads
        self.window_size = window_size
        self.shift_size = shift_size

        self.norm1 = nn.LayerNorm(dim)

        self.attention = nn.MultiheadAttention(
            embed_dim=dim,
            num_heads=num_heads,
            dropout=dropout,
            batch_first=True
        )

        self.norm2 = nn.LayerNorm(dim)

        hidden_dim = int(dim * mlp_ratio)

        self.mlp = nn.Sequential(
            nn.Linear(dim, hidden_dim),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(hidden_dim, dim),
            nn.Dropout(dropout)
        )

    def forward(self, x):

        # Layer normalization
        shortcut = x
        x_norm = self.norm1(x)

        # Shifted-window-compatible attention mechanism.
        # Tokens are arranged from the 4×4 patch grid.
        if self.shift_size > 0:
            x_attn = torch.roll(
                x_norm,
                shifts=-self.shift_size,
                dims=1
            )
        else:
            x_attn = x_norm

        attn_output, _ = self.attention(
            x_attn,
            x_attn,
            x_attn,
            need_weights=False
        )

        if self.shift_size > 0:
            attn_output = torch.roll(
                attn_output,
                shifts=self.shift_size,
                dims=1
            )

        x = shortcut + attn_output

        # MLP
        x = x + self.mlp(self.norm2(x))

        return x


# ==========================================================================
# Four-stage hierarchical Swin network
# ==========================================================================
class UNES_Prune_Swin(nn.Module):

    def __init__(
        self,
        input_dim=1536,
        embed_dim=96,
        num_classes=4
    ):
        super().__init__()

        self.patch_embedding = FeaturePatchEmbedding(
            input_dim=input_dim,
            height=48,
            width=32,
            patch_size=4,
            embed_dim=embed_dim
        )

        # Four hierarchical feature extraction layers
        self.stage1 = nn.Sequential(
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=0
            ),
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=2
            )
        )

        self.stage2 = nn.Sequential(
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=0
            ),
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=2
            )
        )

        self.stage3 = nn.Sequential(
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=0
            ),
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=2
            )
        )

        self.stage4 = nn.Sequential(
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=0
            ),
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=2
            )
        )

        # Final classification head
        self.norm = nn.LayerNorm(embed_dim)
        self.pool = nn.AdaptiveAvgPool1d(1)

        self.classifier = nn.Linear(
            embed_dim,
            num_classes
        )

    def forward(self, x):

        # EfficientNetV2 1536-D features
        x = self.patch_embedding(x)

        # Four hierarchical stages
        x = self.stage1(x)
        x = self.stage2(x)
        x = self.stage3(x)
        x = self.stage4(x)

        # Normalize
        x = self.norm(x)

        # Global pooling
        x = x.transpose(1, 2)
        x = self.pool(x)
        x = x.squeeze(-1)

        # Classification
        logits = self.classifier(x)

        return logits


