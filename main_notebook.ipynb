    ]

    duplicate_image_count = int(
        duplicated_hashes.sum() -
        len(duplicated_hashes)
    )

    within_split_results.append({
        "split": split_name,
        "images": len(split_df),
        "unique_hashes": split_df["sha256"].nunique(),
        "duplicate_hash_groups": len(duplicated_hashes),
