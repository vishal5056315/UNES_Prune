# ---------------------------------------------------------------
print("\n[4/8] Building EfficientNetV2-S...")
print("-" * 60)

import torchvision.models as models


class EfficientNetV2_1536(nn.Module):

    def __init__(
        self,
        num_classes=4,
        feature_dim=1536
    ):

        super().__init__()

        self.backbone = models.efficientnet_v2_s(
            weights=None
        )

        backbone_dim = (
            self.backbone.classifier[1].in_features
        )

        # Remove ImageNet classification head.
        self.backbone.classifier = nn.Identity()

        # Learned 1536-D feature representation.
        self.feature_layer = nn.Linear(
            backbone_dim,
            feature_dim
        )

        # Four-class tumor classifier.
        self.classifier = nn.Linear(
            feature_dim,
            num_classes
        )

    def forward(
        self,
        x,
        return_features=False
    ):

        x = self.backbone(x)

        features = self.feature_layer(x)

        logits = self.classifier(features)

        if return_features:

            return logits, features

        return logits


model = EfficientNetV2_1536(
