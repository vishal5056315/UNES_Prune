import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from PIL import Image

# =========================================================
# PATH
# =========================================================

TRAIN_MANIFEST = (
    "/kaggle/working/UNES_Prune_Segmentation/"
    "train_manifest.csv"
)

OUTPUT_DIR = (
    "/kaggle/working/UNES_Prune_Segmentation/"
    "mask_visualization"
)

os.makedirs(OUTPUT_DIR, exist_ok=True)

# =========================================================
# LOAD MANIFEST
# =========================================================

df = pd.read_csv(TRAIN_MANIFEST)

# =========================================================
# SELECT EXAMPLES
# =========================================================

positive_df = df[
    df["mask_type"] == "positive"
].copy()

negative_df = df[
    df["mask_type"] == "negative"
].copy()

# Select a range of tumor sizes for positive examples
positive_df = positive_df.sort_values(
    "foreground_pixels"
)

if len(positive_df) >= 6:

    positive_indices = np.linspace(
        0,
        len(positive_df) - 1,
        6,
        dtype=int
    )

    selected_positive = positive_df.iloc[
        positive_indices
    ]

else:

    selected_positive = positive_df

# Select first few negative examples
selected_negative = negative_df.head(2)

selected = pd.concat([
    selected_positive,
    selected_negative
]).reset_index(drop=True)

# =========================================================
# CREATE FIGURE
# =========================================================

n = len(selected)

fig, axes = plt.subplots(
    n,
    3,
    figsize=(12, 4 * n)
)

# Handle case of one row
if n == 1:
    axes = np.expand_dims(axes, axis=0)

# =========================================================
# PROCESS EACH EXAMPLE
# =========================================================

for row, (_, record) in enumerate(selected.iterrows()):

    # -----------------------------------------------------
    # Read MRI
    # -----------------------------------------------------

    image = np.asarray(
        Image.open(
            record["image_path"]
        ).convert("RGB")
    )

    # -----------------------------------------------------
    # Read mask
    # -----------------------------------------------------

    mask = np.asarray(
        Image.open(
            record["mask_path"]
        )
    )

    # Binary mask
    binary_mask = mask > 0

    # -----------------------------------------------------
    # Create overlay
    # -----------------------------------------------------

    overlay = image.copy()

    # Highlight mask region
    overlay[binary_mask] = (
        255,
        0,
        0
    )

    # -----------------------------------------------------
    # MRI
    # -----------------------------------------------------

    axes[row, 0].imshow(image)

    axes[row, 0].set_title(
        f"{record['patient']}\n"
        f"MRI: {record['image']}"
    )

    axes[row, 0].axis("off")

    # -----------------------------------------------------
    # MASK
    # -----------------------------------------------------

    axes[row, 1].imshow(
        binary_mask,
        cmap="gray"
    )

    axes[row, 1].set_title(
        f"Ground-truth mask\n"
        f"{record['mask_type']} | "
        f"Foreground pixels: "
        f"{record['foreground_pixels']}"
    )

    axes[row, 1].axis("off")

    # -----------------------------------------------------
    # OVERLAY
    # -----------------------------------------------------

    axes[row, 2].imshow(overlay)

    axes[row, 2].set_title(
        "MRI + Ground-truth overlay"
    )

    axes[row, 2].axis("off")


plt.tight_layout()

# =========================================================
# SAVE FIGURE
# =========================================================

output_file = os.path.join(
    OUTPUT_DIR,
    "unetpp_ground_truth_mask_check.png"
)

plt.savefig(
    output_file,
    dpi=200,
    bbox_inches="tight"
)

plt.show()

# =========================================================
# RESULT
# =========================================================

print()
print("=" * 70)
print("GROUND-TRUTH MASK VISUALIZATION COMPLETE")
print("=" * 70)

print(
    f"Examples displayed : {len(selected)}"
)

print(
    f"Positive examples  : {len(selected_positive)}"
)

print(
    f"Negative examples  : {len(selected_negative)}"
)

print()
print("Figure saved to:")
print(output_file)


