# ============================================================================
# 14. TRAINING FUNCTION
# ============================================================================

def train_one_epoch(
    model,
    loader
):

    model.train()

    running_loss = 0.0
    correct = 0
    total = 0

    progress = tqdm(
        loader,
        desc="Training",
        leave=False
    )

    for batch_idx, (
        images,
        labels
    ) in enumerate(progress):

        images = images.to(
            device,
            non_blocking=True
        )

        labels = labels.to(
            device,
            non_blocking=True
        )

        optimizer.zero_grad(
            set_to_none=True
        )

        logits = model(images)

        loss = criterion(
            logits,
            labels
        )

        loss.backward()

        optimizer.step()

        batch_size = labels.size(0)

        running_loss += (
            loss.item() *
            batch_size
        )

        predictions = logits.argmax(
            dim=1
        )

        correct += (
            predictions == labels
        ).sum().item()

        total += batch_size

        progress_pct = (
            (batch_idx + 1)
            / len(loader)
            * 100
        )

        progress.set_postfix(
            loss=f"{loss.item():.4f}",
            accuracy=f"{100*correct/total:.2f}%",
            progress=f"{progress_pct:.1f}%"
        )

    return (
        running_loss / total,
        100.0 * correct / total
    )


# ============================================================================
# 15. VALIDATION FUNCTION
# ============================================================================

@torch.no_grad()
def validate(
    model,
    loader
):

    model.eval()

    running_loss = 0.0
    correct = 0
    total = 0

    progress = tqdm(
        loader,
        desc="Validation",
        leave=False
    )

    for batch_idx, (
        images,
        labels
    ) in enumerate(progress):

        images = images.to(
            device,
            non_blocking=True
        )

        labels = labels.to(
            device,
            non_blocking=True
        )

        logits = model(images)

        loss = criterion(
            logits,
            labels
        )

        batch_size = labels.size(0)

        running_loss += (
            loss.item() *
            batch_size
        )

        predictions = logits.argmax(
            dim=1
        )

        correct += (
            predictions == labels
        ).sum().item()

        total += batch_size

        progress_pct = (
            (batch_idx + 1)
            / len(loader)
            * 100
        )

        progress.set_postfix(
            loss=f"{loss.item():.4f}",
            accuracy=f"{100*correct/total:.2f}%",
            progress=f"{progress_pct:.1f}%"
        )

    return (
        running_loss / total,
        100.0 * correct / total
    )


# ============================================================================
# 16. TRAIN
# ============================================================================

print("\n" + "=" * 75)
print("STARTING PRETRAINED EFFICIENTNETV2-S TRAINING")
print("=" * 75)

print(
    f"Epochs       : {NUM_EPOCHS}"
