        axes[row_idx, 2].imshow(
            segmented,
            cmap="gray"
        )

        axes[row_idx, 2].set_title(
            "Masked MRI"
        )

        for ax in axes[row_idx]:
            ax.axis("off")

    plt.tight_layout()
    plt.show()


