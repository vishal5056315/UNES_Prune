import os
import pandas as pd
import matplotlib.pyplot as plt

# ---------------------------------------------------------
# Fig. 8: Dice Coefficient vs. Epochs (UNet++)
# ---------------------------------------------------------

history_path = (
    "/kaggle/working/UNES_Prune_Segmentation/"
    "training_results/UNetPP_training_history.csv"
)

output_dir = "/kaggle/working/UNES_Prune_Segmentation"
output_png = os.path.join(
    output_dir,
    "Fig_8_UNetPP_Validation_Dice_vs_Epochs.png"
)
output_svg = os.path.join(
    output_dir,
    "Fig_8_UNetPP_Validation_Dice_vs_Epochs.svg"
)

print("10G-A: Loading U-Net++ training history...")

# Read actual training history
history = pd.read_csv(history_path)

# ---------------------------------------------------------
# Verify required columns
# ---------------------------------------------------------

required_columns = ["epoch", "val_dice"]

missing_columns = [
    col for col in required_columns
    if col not in history.columns
]

if missing_columns:
    raise ValueError(
        f"Required columns are missing: {missing_columns}"
    )

print("10G-B: Required columns verified.")

# ---------------------------------------------------------
# Verify epoch sequence
# ---------------------------------------------------------

epochs = history["epoch"].astype(int)

expected_epochs = list(range(1, len(history) + 1))

if epochs.tolist() != expected_epochs:
    raise ValueError(
        "Epoch sequence is not continuous from 1 to the "
        f"number of recorded epochs."
    )

print(f"10G-C: Verified {len(history)} consecutive epochs.")

# ---------------------------------------------------------
# Extract validation Dice from the actual experiment
# ---------------------------------------------------------

val_dice = history["val_dice"].astype(float)

if val_dice.isna().any():
    raise ValueError("Validation Dice contains missing values.")

if not ((val_dice >= 0) & (val_dice <= 1)).all():
    raise ValueError(
        "Validation Dice contains values outside the valid range [0, 1]."
    )

print("10G-D: Validation Dice values verified.")

# ---------------------------------------------------------
# Find best validation Dice automatically
# ---------------------------------------------------------

best_idx = val_dice.idxmax()

best_epoch = int(history.loc[best_idx, "epoch"])
best_val_dice = float(history.loc[best_idx, "val_dice"])

print(
    f"10G-E: Best validation Dice = "
    f"{best_val_dice:.6f} at epoch {best_epoch}"
)

# ---------------------------------------------------------
# Plot
# ---------------------------------------------------------

plt.figure(figsize=(9, 5.5))

plt.plot(
    epochs,
    val_dice,
    marker="o",
    linewidth=2,
    markersize=5,
    label="Validation Dice"
)

# Mark the actual best validation epoch
plt.scatter(
    best_epoch,
    best_val_dice,
    s=70,
    zorder=5,
    label=f"Best validation Dice = {best_val_dice:.4f} "
          f"(Epoch {best_epoch})"
)

plt.annotate(
    f"{best_val_dice:.4f}",
    xy=(best_epoch, best_val_dice),
    xytext=(8, 10),
    textcoords="offset points",
    fontsize=10
)

plt.xlabel("Epoch")
plt.ylabel("Dice Coefficient")
plt.title("Dice Coefficient vs. Epochs (UNet++)")

plt.xticks(range(1, len(history) + 1, 2))
plt.ylim(0.50, 0.85)

plt.grid(True, alpha=0.3)
plt.legend()
plt.tight_layout()

# ---------------------------------------------------------
# Save figure
# ---------------------------------------------------------

plt.savefig(
    output_png,
    dpi=300,
    bbox_inches="tight"
)

plt.savefig(
    output_svg,
    bbox_inches="tight"
)

plt.show()

print("10G-F: Fig. 8 generated successfully.")
print(f"PNG: {output_png}")
print(f"SVG: {output_svg}")


