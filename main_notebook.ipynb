print()

# =========================================================
# SCAN ALL PATIENT FOLDERS
# =========================================================

for patient in tqdm(
    patient_folders,
    desc="Checking MRI–mask pairs",
    unit="patient"
):

    patient_dir = os.path.join(SEG_ROOT, patient)

    files = os.listdir(patient_dir)

    # MRI files = .tif files that are NOT masks
    mri_files = sorted([
        f for f in files
        if f.lower().endswith(".tif")
        and not f.lower().endswith("_mask.tif")
    ])

    for mri_file in mri_files:

        # Expected mask name
        base_name = os.path.splitext(mri_file)[0]
        mask_file = base_name + "_mask.tif"

        mri_path = os.path.join(
            patient_dir,
            mri_file
        )

        mask_path = os.path.join(
            patient_dir,
            mask_file
        )

        # -------------------------------------------------
        # Check mask existence
        # -------------------------------------------------

        if not os.path.exists(mask_path):

            missing_masks.append({
                "patient": patient,
                "image": mri_file,
                "expected_mask": mask_file
            })

            continue

        # -------------------------------------------------
        # Read MRI and mask
        # -------------------------------------------------

        try:

            mri = np.asarray(
                Image.open(mri_path)
            )

            mask = np.asarray(
                Image.open(mask_path)
            )

        except Exception as e:

            read_errors.append({
                "patient": patient,
                "image": mri_file,
                "mask": mask_file,
                "error": str(e)
            })

            continue

        # -------------------------------------------------
        # Check dimensions
        # -------------------------------------------------

        if mri.shape[:2] != mask.shape[:2]:

            size_mismatches.append({
                "patient": patient,
                "image": mri_file,
                "image_size": mri.shape,
                "mask_size": mask.shape
            })

            continue

        # -------------------------------------------------
        # Store valid pair
        # -------------------------------------------------

        pairs.append({
            "patient": patient,
            "image": mri_file,
            "mask": mask_file,
            "image_path": mri_path,
            "mask_path": mask_path,
            "image_shape": mri.shape,
            "mask_shape": mask.shape,
            "mask_max": int(mask.max()),
            "mask_foreground_pixels": int(np.count_nonzero(mask))
        })


# =========================================================
# SUMMARY
# =========================================================

print("\n")
print("=" * 70)
print("MRI–MASK VALIDATION RESULT")
print("=" * 70)

print(f"Patient folders              : {len(patient_folders)}")
print(f"Valid MRI–mask pairs         : {len(pairs)}")
print(f"Missing masks                : {len(missing_masks)}")
print(f"Size mismatches              : {len(size_mismatches)}")
print(f"Reading errors               : {len(read_errors)}")

# =========================================================
# MASK STATISTICS
# =========================================================

if len(pairs) > 0:

    foreground_pairs = [
        p for p in pairs
        if p["mask_foreground_pixels"] > 0
    ]

    empty_mask_pairs = [
        p for p in pairs
        if p["mask_foreground_pixels"] == 0
    ]

    print()
    print("=" * 70)
    print("MASK CONTENT CHECK")
    print("=" * 70)

    print(
        f"Pairs with tumor foreground : "
        f"{len(foreground_pairs)}"
    )

    print(
        f"Pairs with empty masks      : "
        f"{len(empty_mask_pairs)}"
    )

    # -----------------------------------------------------
    # Image-size distribution
    # -----------------------------------------------------

    from collections import Counter

    image_sizes = Counter(
        p["image_shape"] for p in pairs
    )

    print()
    print("=" * 70)
    print("IMAGE SIZE DISTRIBUTION")
    print("=" * 70)

    for size, count in image_sizes.most_common():

        print(
            f"{str(size):20s} : {count:5d} images"
        )

# =========================================================
# SHOW FIRST FEW VALID PAIRS
# =========================================================

print()
print("=" * 70)
print("FIRST 10 VALID PAIRS")
print("=" * 70)

for i, p in enumerate(pairs[:10], start=1):

    print(
        f"{i:02d}. "
        f"{p['patient']} | "
        f"{p['image']}  <->  {p['mask']} | "
        f"Image: {p['image_shape']} | "
        f"Mask: {p['mask_shape']} | "
        f"Foreground pixels: {p['mask_foreground_pixels']}"
    )


