    )

    scheduler.step()

    epoch_time = (
        time.time() - epoch_start
    )

    current_lr = optimizer.param_groups[
        0
    ]["lr"]

    # --------------------------------------------------------------
    # History
    # --------------------------------------------------------------

    history.append({
