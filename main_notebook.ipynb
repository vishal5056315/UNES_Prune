import numpy as np
import pandas as pd

cm = np.load(
    "/kaggle/working/UNES_Prune_9600_EfficientNetV2_Clean/"
    "swin_genuine_results/Swin_genuine_confusion_matrix.npy"
)

class_names = [
    "Glioma",
    "Meningioma",
    "Pituitary",
    "No Tumor"
]

total = cm.sum()

rows = []

for i, name in enumerate(class_names):

    TP = cm[i, i]

    FN = cm[i, :].sum() - TP

    FP = cm[:, i].sum() - TP

    TN = total - TP - FN - FP

    accuracy = (
        (TP + TN) / total
    ) * 100

    precision = (
        TP / (TP + FP)
    ) * 100 if (TP + FP) > 0 else 0

    recall = (
        TP / (TP + FN)
    ) * 100 if (TP + FN) > 0 else 0

    npv = (
        TN / (TN + FN)
    ) * 100 if (TN + FN) > 0 else 0

    f1 = (
        2 * precision * recall
        /
        (precision + recall)
    ) if (precision + recall) > 0 else 0

    misclassified = FN

    rows.append({
        "Class": name,
        "Accuracy (%)": accuracy,
        "Precision (%)": precision,
        "Recall (%)": recall,
        "NPV (%)": npv,
        "F1-Score (%)": f1,
        "TP": TP,
        "TN": TN,
        "FP": FP,
        "FN": FN,
        "Correct Predictions": TP,
        "Misclassified Predictions": misclassified,
        "Test Samples": cm[i, :].sum()
    })

baseline_table = pd.DataFrame(rows)

print("=" * 110)
print("SAVED SWIN BASELINE — CLASS-WISE RESULTS")
print("=" * 110)

print(
    baseline_table.to_string(
        index=False,
        float_format=lambda x: f"{x:.4f}"
    )
)

print("\nOverall accuracy:")
print(
    f"{np.trace(cm) / total * 100:.4f}%"
)

print("\nMacro Precision:")
print(
    f"{baseline_table['Precision (%)'].mean():.4f}%"
)

print("\nMacro Recall:")
print(
    f"{baseline_table['Recall (%)'].mean():.4f}%"
)

print("\nMacro F1:")
print(
    f"{baseline_table['F1-Score (%)'].mean():.4f}%"
)


import os
import numpy as np
import pandas as pd

# =========================================================
# Table 5: Class-wise Tumor Classification Performance
# =========================================================

base_dir = (
    "/kaggle/working/"
    "UNES_Prune_9600_EfficientNetV2_Clean"
)

swin_dir = os.path.join(
    base_dir,
    "swin_genuine_results"
)

confusion_path = os.path.join(
    swin_dir,
    "Swin_genuine_confusion_matrix.npy"
)

# ---------------------------------------------------------
# Check required file
# ---------------------------------------------------------
if not os.path.exists(confusion_path):
    raise FileNotFoundError(
        f"Confusion matrix not found:\n{confusion_path}"
    )

# ---------------------------------------------------------
# Load saved Swin confusion matrix
# ---------------------------------------------------------
cm = np.load(confusion_path)

if cm.shape != (4, 4):
    raise ValueError(
        f"Expected a 4x4 confusion matrix, "
        f"but found {cm.shape}"
    )

class_names = [
    "Glioma",
    "Meningioma",
    "Pituitary",
    "No Tumor"
]

print("=" * 80)
print("Saved Swin confusion matrix")
print("=" * 80)
print(cm)

# ---------------------------------------------------------
# Calculate class-wise metrics
# ---------------------------------------------------------
total_samples = int(cm.sum())

rows = []

for i, class_name in enumerate(class_names):

    # One-vs-rest quantities
    TP = int(cm[i, i])

    FN = int(
        cm[i, :].sum() - TP
    )

    FP = int(
        cm[:, i].sum() - TP
    )

    TN = int(
        total_samples
        - TP
        - FN
        - FP
    )

    # Class-wise recognition accuracy
    # = correctly classified samples
    #   / total samples belonging to that class
    class_total = int(
        cm[i, :].sum()
    )

    class_accuracy = (
        TP / class_total
    ) * 100

    precision = (
        TP / (TP + FP)
    ) * 100 if (TP + FP) > 0 else 0.0

    recall = (
        TP / (TP + FN)
    ) * 100 if (TP + FN) > 0 else 0.0

    # Negative Predictive Value
    npv = (
        TN / (TN + FN)
    ) * 100 if (TN + FN) > 0 else 0.0

    f1 = (
        2 * precision * recall
        /
        (precision + recall)
    ) if (precision + recall) > 0 else 0.0

    misclassified = FN

    rows.append({
        "Class": class_name,
        "Class Accuracy (%)": class_accuracy,
        "Precision (%)": precision,
        "Recall (%)": recall,
        "NPV (%)": npv,
        "F1-Score (%)": f1,
        "TP": TP,
        "TN": TN,
        "FP": FP,
        "FN": FN,
        "Correct Predictions": TP,
        "Misclassified Predictions": misclassified,
        "Test Samples": class_total
    })

table5_classwise = pd.DataFrame(rows)

# ---------------------------------------------------------
# Overall metrics
# ---------------------------------------------------------
overall_accuracy = (
    np.trace(cm)
    /
    total_samples
) * 100

macro_precision = (
    table5_classwise[
        "Precision (%)"
    ].mean()
)

macro_recall = (
    table5_classwise[
        "Recall (%)"
    ].mean()
)

macro_f1 = (
    table5_classwise[
        "F1-Score (%)"
    ].mean()
)

total_correct = int(
    np.trace(cm)
)

total_misclassified = int(
    total_samples - total_correct
)

# ---------------------------------------------------------
# Overall summary
# ---------------------------------------------------------
overall_table = pd.DataFrame({
    "Metric": [
        "Overall Accuracy (%)",
        "Macro Precision (%)",
        "Macro Recall (%)",
        "Macro F1-Score (%)",
        "Total Correct Predictions",
        "Total Misclassified Predictions",
        "Total Test Samples"
    ],
    "Value": [
        overall_accuracy,
        macro_precision,
        macro_recall,
        macro_f1,
        total_correct,
        total_misclassified,
        total_samples
    ]
})

# ---------------------------------------------------------
# Print Table 5
# ---------------------------------------------------------
print("\n")
print("=" * 120)
print(
    "TABLE 5: CLASS-WISE TUMOR CLASSIFICATION "
    "PERFORMANCE OF UNES-PRUNE"
)
print("=" * 120)

print(
    table5_classwise.to_string(
        index=False,
        float_format=lambda x: f"{x:.4f}"
    )
)

print("\n")
print("=" * 80)
print("OVERALL CLASSIFICATION RESULTS")
print("=" * 80)

print(
    overall_table.to_string(
        index=False,
        float_format=lambda x: f"{x:.4f}"
    )
)

# ---------------------------------------------------------
# Save Excel
# ---------------------------------------------------------
output_path = os.path.join(
    base_dir,
    "Table_5_Classwise_Tumor_Classification_Performance.xlsx"
)

with pd.ExcelWriter(
    output_path,
    engine="openpyxl"
) as writer:

    table5_classwise.to_excel(
        writer,
        sheet_name="Table 5",
        index=False
    )

    overall_table.to_excel(
        writer,
        sheet_name="Overall Results",
        index=False
    )

    # Save the actual confusion matrix
    confusion_df = pd.DataFrame(
        cm,
        index=class_names,
        columns=class_names
    )

    confusion_df.to_excel(
        writer,
        sheet_name="Confusion Matrix"
    )

print("\n")
print("=" * 80)
print("Table 5 saved successfully")
print("=" * 80)
print(output_path)


