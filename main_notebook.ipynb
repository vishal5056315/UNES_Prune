# Step 10AJ: fine-tune the pruned Swin model

import torch
import torch.nn as nn

pruned_model = pruned_model.to(device)

criterion = nn.CrossEntropyLoss()

optimizer = torch.optim.AdamW(
    pruned_model.parameters(),
    lr=2e-5,
    weight_decay=1e-4
)

scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
    optimizer,
    T_max=10
)

num_epochs = 10

best_val_acc = 0.0
best_state = None

for epoch in range(num_epochs):

    pruned_model.train()

    train_correct = 0
    train_total = 0
    train_loss = 0.0

    for start in range(0, len(X_train_swin), 32):

        end = min(start + 32, len(X_train_swin))

        xb = X_train_swin[start:end].to(device)
        yb = y_train_swin[start:end].to(device)

        optimizer.zero_grad()

        outputs = pruned_model(xb)
        loss = criterion(outputs, yb)

        loss.backward()
        optimizer.step()

        train_loss += loss.item() * len(xb)

        preds = outputs.argmax(dim=1)
        train_correct += (preds == yb).sum().item()
        train_total += len(yb)

    scheduler.step()

    # Validation
    pruned_model.eval()

    val_correct = 0
    val_total = 0
    val_loss = 0.0

    with torch.no_grad():

        for start in range(0, len(X_val_swin), 32):

            end = min(start + 32, len(X_val_swin))

            xb = X_val_swin[start:end].to(device)
            yb = y_val_swin[start:end].to(device)

            outputs = pruned_model(xb)
            loss = criterion(outputs, yb)

            val_loss += loss.item() * len(xb)

            preds = outputs.argmax(dim=1)
            val_correct += (preds == yb).sum().item()
            val_total += len(yb)

    train_acc = train_correct / train_total
    val_acc = val_correct / val_total

    train_loss /= train_total
    val_loss /= val_total

    if val_acc > best_val_acc:
        best_val_acc = val_acc
        best_state = {
            k: v.detach().cpu().clone()
            for k, v in pruned_model.state_dict().items()
        }

    print(
        f"Epoch {epoch + 1:02d}/{num_epochs} | "
        f"Train Loss: {train_loss:.4f} | "
        f"Train Acc: {train_acc * 100:.2f}% | "
        f"Val Loss: {val_loss:.4f} | "
        f"Val Acc: {val_acc * 100:.2f}%"
    )

# Restore best validation model
pruned_model.load_state_dict(best_state)
pruned_model.to(device)

print()
print(f"Best validation accuracy: {best_val_acc * 100:.2f}%")


