print("-" * 60)

class_names = [
    "glioma",
    "meningioma",
    "pituitary",
    "notumor"
]

class_to_idx = {
    class_name: idx
    for idx, class_name in enumerate(class_names)
}

print("Class mapping:")
for class_name, idx in class_to_idx.items():
    print(f"  {class_name:12s} -> {idx}")


class EfficientNetDataset(Dataset):

    def __init__(self, dataframe, transform=None):

        self.dataframe = dataframe.reset_index(drop=True)
        self.transform = transform

    def __len__(self):

        return len(self.dataframe)

    def __getitem__(self, index):

        row = self.dataframe.iloc[index]

        image_path = row["segmented_image_path"]
        class_name = row["class"]

        if not os.path.exists(image_path):
            raise FileNotFoundError(
                f"Image not found: {image_path}"
            )

        image = Image.open(image_path).convert("L")

        if self.transform is not None:
            image = self.transform(image)

        # EfficientNetV2 expects 3 input channels.
        # The original MRI is grayscale, therefore replicate
        # the grayscale channel rather than changing the model's
        # first convolutional layer.
        image = image.repeat(3, 1, 1)

        label = class_to_idx[class_name]

        return image, label


# ---------------------------------------------------------------
# [4/6] Define preprocessing
# ---------------------------------------------------------------
print("\n[4/6] Defining EfficientNetV2 preprocessing...")
print("-" * 60)

transform = transforms.Compose([
    transforms.Resize(
        (IMAGE_SIZE, IMAGE_SIZE)
    ),
    transforms.ToTensor()
])

print("Resize                    : 256 × 256")
print("Tensor conversion         : enabled")
print("Input channels            : grayscale replicated to 3")
print("Additional augmentation   : none")


# ---------------------------------------------------------------
# [5/6] Create datasets and test actual images
# ---------------------------------------------------------------
