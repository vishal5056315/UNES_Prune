    })

    history_df = pd.DataFrame(
        history
    )

    history_df.to_csv(
        HISTORY_PATH,
        index=False
    )

    # --------------------------------------------------------------
    # Best model
    # --------------------------------------------------------------

    is_best = (
        val_accuracy >
