    segmented_path = row[
        "segmented_image_path"
    ]

    original = Image.open(
        original_path
    ).convert("L")

    original = original.resize(
        (256, 256),
        Image.Resampling.BILINEAR
    )

    original = np.asarray(
        original,
        dtype=np.float32
    ) / 255.0

    mask = Image.open(
        mask_path
    ).convert("L")

    mask = np.asarray(
        mask,
        dtype=np.float32
    ) / 255.0

    segmented = Image.open(
        segmented_path
    ).convert("L")

    segmented = np.asarray(
        segmented,
        dtype=np.float32
    ) / 255.0

    # Three-channel representation:
    # channel 0 = original MRI
    # channel 1 = masked MRI
    # channel 2 = predicted mask

    three_channel = np.stack(
        [
            original,
            segmented,
            mask
        ],
        axis=0
    )

    class_name = str(
        row["class"]
    )

    split_name = str(
        row["split"]
    )

    base_name = os.path.splitext(
        os.path.basename(
            original_path
        )
    )[0]

    save_dir = os.path.join(
        input_root,
        split_name,
        class_name
    )

    os.makedirs(
        save_dir,
        exist_ok=True
    )

    save_path = os.path.join(
        save_dir,
        base_name + ".npy"
    )

    np.save(
        save_path,
        three_channel.astype(
            np.float32
        )
    )

    records.append({
        "input_path": save_path,
        "original_image_path": original_path,
        "predicted_mask_path": mask_path,
        "segmented_image_path": segmented_path,
        "class": class_name,
        "split": split_name,
        "predicted_tumor_pixels":
            int(
                row[
                    "predicted_tumor_pixels"
                ]
            ),
        "predicted_tumor_percentage":
            float(
                row[
                    "predicted_tumor_percentage"
                ]
            )
    })


input_df = pd.DataFrame(
    records
)

input_df.to_csv(
    input_manifest,
    index=False
)

print("\nPrepared:", len(input_df))
print("Manifest:", input_manifest)

