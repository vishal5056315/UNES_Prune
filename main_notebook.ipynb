print(f"Maximum : {values.max()}")
print(f"Mean    : {values.mean():.2f}")
print(f"Median  : {np.median(values):.2f}")
print(f"Std     : {values.std():.2f}")

# =========================================================
# SIZE GROUPS
# =========================================================

bins = [
    -1,
    10,
    50,
    100,
    500,
    1000,
    5000,
    10000,
    20000,
    65536
]

labels = [
    "1–10",
    "11–50",
    "51–100",
    "101–500",
    "501–1,000",
    "1,001–5,000",
    "5,001–10,000",
    "10,001–20,000",
    "20,001+"
]

positive_df["mask_size_group"] = pd.cut(
    positive_df["foreground_pixels_verified"],
    bins=bins,
    labels=labels
)

distribution = (
    positive_df["mask_size_group"]
    .value_counts()
    .reindex(labels, fill_value=0)
)

print()
print("=" * 70)
print("TUMOR MASK SIZE DISTRIBUTION")
print("=" * 70)

print(distribution)

print()
print("=" * 70)
print("PERCENTAGE DISTRIBUTION")
print("=" * 70)

print(
    (distribution / len(positive_df) * 100)
    .round(2)
)

# =========================================================
# TINY MASK COUNTS
# =========================================================

print()
print("=" * 70)
print("VERY SMALL MASK CHECK")
print("=" * 70)

for limit in [10, 25, 50, 100, 200, 500]:

    count = np.sum(
        values <= limit
    )

    percentage = (
        count / len(values) * 100
    )

    print(
        f"<= {limit:4d} pixels : "
