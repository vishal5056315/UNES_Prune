import torch
import torch.nn as nn
import torch.optim as optim

print("Fine-tuning 49.37% pruned Swin")
print("================================")

device = next(pruned_model_49.parameters()).device

criterion_pruned = nn.CrossEntropyLoss()

optimizer_pruned = optim.AdamW(
    pruned_model_49.parameters(),
    lr=1e-5,
    weight_decay=1e-4
)

scheduler_pruned = optim.lr_scheduler.CosineAnnealingLR(
    optimizer_pruned,
    T_max=5
)

epochs = 5
batch_size = 64

best_val_accuracy = -1.0
best_state = None

history_pruned = []

for epoch in range(epochs):

    pruned_model_49.train()

    train_correct = 0
    train_total = 0
    train_loss_sum = 0.0

    for start in range(0, len(X_train_swin), batch_size):

        end = min(start + batch_size, len(X_train_swin))

        x_batch = X_train_swin[start:end].to(device)
        y_batch = y_train_swin[start:end].to(device)

        optimizer_pruned.zero_grad()

        logits = pruned_model_49(x_batch)

        loss = criterion_pruned(
            logits,
            y_batch
        )

        loss.backward()
        optimizer_pruned.step()

        train_loss_sum += (
            loss.item() * len(y_batch)
        )

        train_correct += (
            (logits.argmax(dim=1) == y_batch)
            .sum()
            .item()
        )

        train_total += len(y_batch)

    scheduler_pruned.step()

    # -----------------------------------------------------
    # Validation
    # -----------------------------------------------------
    pruned_model_49.eval()

    val_correct = 0
    val_total = 0
    val_loss_sum = 0.0

    with torch.no_grad():

        for start in range(0, len(X_val_swin), batch_size):

            end = min(
                start + batch_size,
                len(X_val_swin)
            )

            x_batch = X_val_swin[start:end].to(device)
            y_batch = y_val_swin[start:end].to(device)

            logits = pruned_model_49(x_batch)

            loss = criterion_pruned(
                logits,
                y_batch
            )

            val_loss_sum += (
                loss.item() * len(y_batch)
            )

            val_correct += (
                (logits.argmax(dim=1) == y_batch)
                .sum()
                .item()
            )

            val_total += len(y_batch)

    train_loss = train_loss_sum / train_total
    train_accuracy = train_correct / train_total * 100

    val_loss = val_loss_sum / val_total
    val_accuracy = val_correct / val_total * 100

    history_pruned.append({
        "epoch": epoch + 1,
        "train_loss": train_loss,
        "train_accuracy": train_accuracy,
        "validation_loss": val_loss,
        "validation_accuracy": val_accuracy,
        "learning_rate": optimizer_pruned.param_groups[0]["lr"]
    })

    print(
        f"Epoch {epoch + 1:02d}/{epochs} | "
        f"Train Loss: {train_loss:.4f} | "
        f"Train Acc: {train_accuracy:.2f}% | "
