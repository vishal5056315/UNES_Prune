# Find the exact 1536-D -> Swin input preparation in the notebook source

from pathlib import Path

source_path = "/mnt/data/Pasted markdown(9).md"

print("=" * 70)
print("SEARCHING SWIN INPUT PREPARATION")
print("=" * 70)

text = Path(source_path).read_text(
    encoding="utf-8",
    errors="ignore"
)

lines = text.splitlines()

patterns = [
    "1536",
    "96, 16",
    "96,16",
    "reshape",
    "view",
    "Swin",
    "patch_embedding",
    "features.reshape",
    "features.view",
    "X_test",
    "test_features"
]

matches = []

for i, line in enumerate(lines):
    line_lower = line.lower()

    if any(pattern.lower() in line_lower for pattern in patterns):
        matches.append(i)

print(f"Matching source lines found: {len(matches)}")

# Show relevant surrounding context, avoiding excessive output.
shown = set()

for idx in matches:
    start = max(0, idx - 4)
    end = min(len(lines), idx + 5)

    block_key = (start, end)

    if block_key in shown:
        continue

    shown.add(block_key)

    print("\n" + "-" * 70)
    print(f"Source lines {start + 1}–{end}")
    print("-" * 70)

    for j in range(start, end):
        print(f"{j + 1:5d}: {lines[j]}")

print("\nSearch completed: 100%")


