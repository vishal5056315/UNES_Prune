# ============================================================
# STEP 9: CREATE MASKED 9,600-IMAGE DATASET
# ============================================================
# The U-Net++ was trained using the LGG MRI + TRUE MASK dataset.
# It has now generated predicted masks for the 9,600 target images.
#
# This step applies those predicted masks to the target images
# and creates the segmentation-based target dataset.
# ============================================================

import numpy as np
import pandas as pd
from pathlib import Path
from PIL import Image
from tqdm.auto import tqdm

print("=" * 70)
print("STEP 9: CREATING SEGMENTATION-BASED TARGET DATASET")
print("=" * 70)

# ------------------------------------------------------------
# Paths
# ------------------------------------------------------------
TARGET_OUTPUT = Path(
    "/kaggle/working/UNES_Prune_9600_Segmented"
)

MASK_MANIFEST = Path(
    "/kaggle/working/UNES_Prune_9600_With_Masks/"
    "predicted_masks_manifest.csv"
)

SEGMENTED_DIR = TARGET_OUTPUT / "images"

SEGMENTED_DIR.mkdir(
    parents=True,
    exist_ok=True
)

# ------------------------------------------------------------
# Load predicted-mask manifest
# ------------------------------------------------------------
print("\n[1/4] Loading predicted-mask manifest...")
print("-" * 50)

df = pd.read_csv(MASK_MANIFEST)

print("Images loaded:", len(df))

assert len(df) == 9600, (
    f"Expected 9600 images, found {len(df)}"
)


# ------------------------------------------------------------
# Generate masked images
# ------------------------------------------------------------
print("\n[2/4] Applying predicted masks...")
print("-" * 50)

new_records = []

progress = tqdm(
    df.iterrows(),
    total=len(df),
    desc="Creating segmented images",
    unit="image"
)

for index, row in progress:

    # Original preprocessed image
    image = np.asarray(
        Image.open(
            row["processed_path"]
        ).convert("L"),
        dtype=np.uint8
    )

    # Predicted binary mask
    mask = np.asarray(
        Image.open(
            row["predicted_mask_path"]
        ).convert("L"),
        dtype=np.uint8
    )

    # Convert mask to binary
    binary_mask = mask > 0

    # Keep only predicted segmented region
    segmented_image = np.where(
        binary_mask,
        image,
        0
    ).astype(np.uint8)

    # Preserve split/class structure
    output_dir = (
        SEGMENTED_DIR /
        row["split"] /
        row["class"]
    )

    output_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    output_path = (
        output_dir /
        row["processed_filename"]
    )

    Image.fromarray(
        segmented_image
    ).save(output_path)

    new_records.append({
        "original_filename": row["original_filename"],
        "processed_filename": row["processed_filename"],
        "class": row["class"],
        "split": row["split"],
        "original_image_path": row["processed_path"],
        "predicted_mask_path": row["predicted_mask_path"],
        "segmented_image_path": str(output_path),
        "predicted_tumor_pixels": row[
            "predicted_tumor_pixels"
        ],
        "predicted_tumor_percentage": row[
            "predicted_tumor_percentage"
        ]
    })

    completed = (
        (index + 1) /
        len(df)
    ) * 100

    progress.set_postfix(
        progress=f"{completed:.1f}%"
    )


# ------------------------------------------------------------
# Save manifest
# ------------------------------------------------------------
print("\n[3/4] Saving segmented-image manifest...")
print("-" * 50)

segmented_df = pd.DataFrame(new_records)

segmented_manifest = (
    TARGET_OUTPUT /
    "segmented_dataset_manifest.csv"
)

segmented_df.to_csv(
    segmented_manifest,
    index=False
)

print(
    "Segmented images created:",
    len(segmented_df)
)

print("\nImages by split:")
print(
    segmented_df["split"]
    .value_counts()
    .to_string()
)

print("\nImages by class:")
print(
    segmented_df["class"]
    .value_counts()
    .to_string()
)


# ------------------------------------------------------------
# Verify files
# ------------------------------------------------------------
print("\n[4/4] Verifying output files...")
print("-" * 50)

segmented_files = list(
    SEGMENTED_DIR.rglob("*.jpg")
)

print("Manifest records :", len(segmented_df))
print("Segmented files  :", len(segmented_files))

if (
    len(segmented_df) == 9600
    and len(segmented_files) == 9600
):
    print(
        "PASS: All 9,600 segmented target images "
        "were created successfully."
    )
else:
    print(
        "WARNING: Expected 9,600 segmented images."
    )

print("\nOutput directory:")
print(TARGET_OUTPUT)

print("\nManifest:")
print(segmented_manifest)

print("\n" + "=" * 70)
print("STEP 9 COMPLETE")
