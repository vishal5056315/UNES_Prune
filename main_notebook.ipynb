import os
import torch
import pandas as pd
from openpyxl import load_workbook
from openpyxl.styles import Font, Alignment, PatternFill, Border, Side

print("Table 3 calculation started: 0%")

# =========================================================
# 1. Use the actual original model already in memory
# =========================================================
original_model = swin_model.cpu().eval()

# Verify original parameter count directly
original_parameters = sum(
    p.numel()
    for p in original_model.parameters()
)

print("\nOriginal Swin model")
print("-------------------")
print("Parameters:", f"{original_parameters:,}")

# =========================================================
# 2. Reconstruct the structured-pruned architecture
# =========================================================
# Do not change the original model.
# A separate copy is created for the pruned architecture.

import copy

pruned_model = copy.deepcopy(
    original_model
).cpu().eval()

for block in pruned_model.blocks:

    input_dim = block.mlp[0].in_features
    output_dim = block.mlp[2].out_features

    block.mlp = torch.nn.Sequential(
        torch.nn.Linear(
            input_dim,
            96
        ),
        torch.nn.GELU(),
        torch.nn.Linear(
            96,
            output_dim
        )
    )

# Verify pruned parameter count directly
pruned_parameters = sum(
    p.numel()
    for p in pruned_model.parameters()
)

print("\nStructured-pruned Swin model")
print("-----------------------------")
print("Parameters:", f"{pruned_parameters:,}")

print("\nTable 3 architecture calculation: 25%")

# =========================================================
# 3. Verify architecture directly from models
# =========================================================
num_blocks = len(
    original_model.blocks
)

embedding_dim = (
    original_model.patch_embedding.out_features
)

attention_heads = (
    original_model.blocks[0].attn.num_heads
)

original_hidden = (
    original_model.blocks[0].mlp[0].out_features
)

pruned_hidden = (
    pruned_model.blocks[0].mlp[0].out_features
)

print("\nArchitecture verified from model objects:")
print("Transformer blocks:", num_blocks)
print("Embedding dimension:", embedding_dim)
print("Attention heads:", attention_heads)
print("Original MLP hidden:", original_hidden)
print("Pruned MLP hidden:", pruned_hidden)

# =========================================================
# 4. FLOPs using PyTorch profiler
# =========================================================
print("\nCalculating FLOPs from actual forward passes...")

dummy_input = torch.randn(
    1,
    96,
    16
)

def calculate_profiler_flops(model, x):

    model.eval()

    with torch.no_grad():

        with torch.profiler.profile(
            activities=[
                torch.profiler.ProfilerActivity.CPU
            ],
            record_shapes=True,
            with_flops=True
        ) as prof:

            model(x)

    total_flops = 0

    for event in prof.key_averages():

        if hasattr(event, "flops"):

            if event.flops is not None:
                total_flops += event.flops

    return int(total_flops)


original_flops = calculate_profiler_flops(
    original_model,
    dummy_input
)

pruned_flops = calculate_profiler_flops(
    pruned_model,
    dummy_input
)

print(
    "\nOriginal Swin FLOPs:",
    f"{original_flops:,}"
)

print(
    "Structured-pruned Swin FLOPs:",
    f"{pruned_flops:,}"
)

print("\nFLOPs calculation completed: 55%")

# =========================================================
# 5. Calculate reductions from the computed values
# =========================================================
parameter_reduction = (
    (
        original_parameters
        - pruned_parameters
    )
    / original_parameters
) * 100

flops_reduction = (
    (
        original_flops
        - pruned_flops
    )
    / original_flops
) * 100

print("\nComputed reductions:")
print(
    "Parameter reduction:",
    f"{parameter_reduction:.4f}%"
)

print(
    "FLOPs reduction:",
    f"{flops_reduction:.4f}%"
)

# =========================================================
# 6. Create the table from calculated values
# =========================================================
table3 = pd.DataFrame([
    [
        "Transformer Blocks",
        num_blocks,
        num_blocks
    ],
    [
        "Token Embedding Dimension",
        embedding_dim,
        embedding_dim
    ],
    [
        "Attention Heads",
        attention_heads,
        attention_heads
    ],
    [
        "Window Size",
        "4 × 4",
        "4 × 4"
    ],
    [
        "MLP Hidden Dimension",
        original_hidden,
        pruned_hidden
    ],
    [
        "MLP Structure",
        f"{embedding_dim} → {original_hidden} → {embedding_dim}",
        f"{embedding_dim} → {pruned_hidden} → {embedding_dim}"
    ],
    [
        "Pruning Type",
        "—",
        "Structured MLP pruning"
    ],
    [
        "Pruning Target",
        "—",
        "MLP intermediate dimension"
    ],
    [
        "Parameters",
        original_parameters,
        pruned_parameters
    ],
    [
        "Theoretical FLOPs",
        original_flops,
        pruned_flops
    ],
    [
        "Parameter Reduction",
        "—",
        f"{parameter_reduction:.4f}%"
    ],
    [
        "FLOPs Reduction",
        "—",
        f"{flops_reduction:.4f}%"
    ]
], columns=[
    "Metric / Configuration",
    "Original Swin",
    "Structured-Pruned Swin"
])

# =========================================================
# 7. PRINT THE TABLE BEFORE SAVING
# =========================================================
print("\n")
print("=" * 90)
print("TABLE 3 - STRUCTURED PRUNING CONFIGURATION")
