# STEP 7: APPLY TRAINED U-NET++ TO YOUR 9,600 TARGET IMAGES
# Generate predicted tumor masks
# ============================================================

import os
import numpy as np
import pandas as pd
from pathlib import Path
from PIL import Image
from tqdm.auto import tqdm

import torch
import torch.nn.functional as F

# ------------------------------------------------------------
# Paths
# ------------------------------------------------------------
TARGET_DIR = Path("/kaggle/working/UNES_Prune_9600_Preprocessed")

MANIFEST_PATH = TARGET_DIR / "preprocessing_manifest.csv"

OUTPUT_DIR = Path("/kaggle/working/UNES_Prune_9600_With_Masks")
MASK_DIR = OUTPUT_DIR / "predicted_masks"

MASK_DIR.mkdir(parents=True, exist_ok=True)

BEST_MODEL_PATH = Path(
    "/kaggle/working/UNES_Prune_Segmentation/models/"
    "UNES_Prune_UNetPP_best.pth"
)

print("=" * 70)
print("STEP 7: GENERATING PREDICTED MASKS FOR 9,600 TARGET IMAGES")
print("=" * 70)

# ------------------------------------------------------------
# 1. Load target manifest
# ------------------------------------------------------------
print("\n[1/5] Loading target dataset manifest...")
print("-" * 50)

target_df = pd.read_csv(MANIFEST_PATH)

print("Target images:", len(target_df))

assert len(target_df) == 9600, (
    f"Expected 9600 images, found {len(target_df)}"
)

print("\nImages by split:")
print(target_df["split"].value_counts().to_string())

print("\nImages by class:")
print(target_df["class"].value_counts().to_string())


# ------------------------------------------------------------
# 2. Load trained U-Net++ model
# ------------------------------------------------------------
print("\n[2/5] Loading trained U-Net++...")
print("-" * 50)

model = UNES_Prune_UNetPP().to(DEVICE)

checkpoint = torch.load(
    BEST_MODEL_PATH,
    map_location=DEVICE
)

model.load_state_dict(
    checkpoint["model_state_dict"]
)

model.eval()

print("Best epoch :", checkpoint["epoch"])
print("LGG Val Dice:", checkpoint["val_dice"])
print("LGG Val IoU :", checkpoint["val_iou"])

print("Model loaded successfully.")


# ------------------------------------------------------------
# 3. Generate predicted masks
# ------------------------------------------------------------
print("\n[3/5] Generating predicted masks...")
print("-" * 50)

results = []

with torch.no_grad():

    progress = tqdm(
        target_df.iterrows(),
        total=len(target_df),
        desc="U-Net++ inference",
        unit="image"
    )

    for index, row in progress:

        image_path = Path(row["processed_path"])

        # Read preprocessed 256x256 grayscale image
        image = Image.open(image_path).convert("L")

        image_array = np.asarray(
            image,
            dtype=np.float32
        ) / 255.0

        # [H,W] -> [1,1,H,W]
        image_tensor = torch.from_numpy(
            image_array
        ).unsqueeze(0).unsqueeze(0).to(DEVICE)

        # U-Net++ prediction
        logits = model(image_tensor)

        probability = torch.sigmoid(logits)

        # Binary predicted mask
        predicted_mask = (
            probability >= 0.5
        ).float()

        predicted_mask = (
            predicted_mask
            .squeeze()
            .cpu()
            .numpy()
            .astype(np.uint8)
        )

        # Save as 0/255 PNG
        mask_uint8 = predicted_mask * 255

        # Preserve class/split structure
        relative_name = (
            Path(row["split"])
            / row["class"]
            / (
                Path(row["processed_filename"]).stem
                + "_predicted_mask.png"
            )
        )

        output_mask_path = MASK_DIR / relative_name

        output_mask_path.parent.mkdir(
            parents=True,
            exist_ok=True
        )

        Image.fromarray(
            mask_uint8,
            mode="L"
        ).save(output_mask_path)

        # Calculate predicted tumor area
        tumor_pixels = int(
            np.count_nonzero(predicted_mask)
        )

        tumor_percentage = (
            tumor_pixels /
            predicted_mask.size
        ) * 100.0

        results.append({
            "original_filename": row["original_filename"],
            "processed_filename": row["processed_filename"],
            "class": row["class"],
            "split": row["split"],
            "processed_path": row["processed_path"],
            "predicted_mask_path": str(output_mask_path),
            "predicted_tumor_pixels": tumor_pixels,
            "predicted_tumor_percentage": tumor_percentage
        })

        completed = (
            (index + 1) /
            len(target_df)
        ) * 100

        progress.set_postfix(
            progress=f"{completed:.1f}%"
        )


# ------------------------------------------------------------
# 4. Save mask manifest
# ------------------------------------------------------------
print("\n[4/5] Saving predicted-mask manifest...")
print("-" * 50)

mask_df = pd.DataFrame(results)

MASK_MANIFEST = (
    OUTPUT_DIR /
    "predicted_masks_manifest.csv"
)

mask_df.to_csv(
    MASK_MANIFEST,
    index=False
)

print("Predicted masks generated:", len(mask_df))

print("\nPredicted tumor area:")
print(
    mask_df[
        "predicted_tumor_pixels"
    ].describe().to_string()
)

print("\nImages with non-empty predicted masks:")

nonempty = (
    mask_df["predicted_tumor_pixels"] > 0
).sum()

empty = (
    mask_df["predicted_tumor_pixels"] == 0
).sum()

print("Non-empty masks:", nonempty)
print("Empty masks    :", empty)

print("\nBy class:")
print(
    mask_df.groupby("class")[
        "predicted_tumor_pixels"
    ].agg(
        ["count", "mean", "median", "min", "max"]
    ).to_string()
)


# ------------------------------------------------------------
# 5. Final verification
# ------------------------------------------------------------
print("\n[5/5] Verifying generated files...")
print("-" * 50)

actual_mask_files = list(
    MASK_DIR.rglob("*_predicted_mask.png")
)

print("Manifest records :", len(mask_df))
print("Mask files found :", len(actual_mask_files))

if len(mask_df) == 9600 and len(actual_mask_files) == 9600:
    print("PASS: All 9,600 target images have predicted masks.")
else:
    print("WARNING: Mask count does not equal 9,600.")

print("\nOutput directory:")
print(OUTPUT_DIR)

print("\nMask manifest:")
print(MASK_MANIFEST)

print("\n" + "=" * 70)
print("STEP 7 COMPLETE")
print("=" * 70)


