)

plt.savefig(
    dice_plot_path,
    dpi=200,
    bbox_inches="tight"
)

plt.show()

# ============================================================
# PLOT LOSS
# ============================================================

plt.figure(figsize=(9, 6))

plt.plot(
    history["epoch"],
    history["train_loss"],
    marker="o",
    label="Training Loss"
)

plt.plot(
    history["epoch"],
