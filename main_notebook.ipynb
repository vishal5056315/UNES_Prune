class OriginalPlusMaskDataset(Dataset):

    def __init__(
        self,
        dataframe
    ):
        self.df = dataframe.reset_index(
            drop=True
        )

    def __len__(self):
        return len(self.df)

    def __getitem__(self, idx):

        row = self.df.iloc[idx]

        original = np.array(
            Image.open(
                row["original_image_path"]
            ).convert("L"),
            dtype=np.float32
        )

        segmented = np.array(
            Image.open(
                row["segmented_image_path"]
            ).convert("L"),
            dtype=np.float32
        )

        original = original / 255.0

        mask = (
            segmented > 0
        ).astype(np.float32)

        image = np.stack(
            [
                original,
                mask
            ],
            axis=0
        )

        image = torch.from_numpy(
            image
        ).float()

        label = torch.tensor(
            int(row["label"]),
            dtype=torch.long
        )

        return image, label


