import os
import numpy as np
import matplotlib.pyplot as plt

# ---------------------------------------------------------
# Fig. 9: Confusion Matrix
# ---------------------------------------------------------

base_dir = "/kaggle/working/UNES_Prune_9600_EfficientNetV2_Clean"

cm_path = os.path.join(
    base_dir,
    "swin_genuine_results",
    "Swin_genuine_confusion_matrix.npy"
)

output_dir = os.path.join(base_dir, "figures")
os.makedirs(output_dir, exist_ok=True)

output_png = os.path.join(
    output_dir,
    "Fig_9_Confusion_Matrix_UNES_Prune.png"
)

output_svg = os.path.join(
    output_dir,
    "Fig_9_Confusion_Matrix_UNES_Prune.svg"
)

print("11G-A: Loading saved confusion matrix...")

# ---------------------------------------------------------
# Load actual confusion matrix
# ---------------------------------------------------------

cm = np.load(cm_path)

print("Confusion matrix:")
print(cm)

# ---------------------------------------------------------
# Verify matrix
# ---------------------------------------------------------

if cm.shape != (4, 4):
    raise ValueError(
        f"Expected a 4 x 4 confusion matrix, "
        f"but found {cm.shape}."
    )

if not np.issubdtype(cm.dtype, np.integer):
    raise ValueError(
        f"Confusion matrix should contain integer counts, "
        f"but found dtype {cm.dtype}."
    )

if np.any(cm < 0):
    raise ValueError("Confusion matrix contains negative values.")

total_samples = int(cm.sum())
row_totals = cm.sum(axis=1)
column_totals = cm.sum(axis=0)

if total_samples != 800:
    raise ValueError(
        f"Expected 800 test predictions, "
        f"but found {total_samples}."
    )

print("11G-B: Matrix shape verified: 4 x 4")
print("11G-C: Total test predictions:", total_samples)
print("11G-D: Row totals:", row_totals.tolist())
print("11G-E: Column totals:", column_totals.tolist())

# ---------------------------------------------------------
# Class order corresponding to the saved Swin result
# ---------------------------------------------------------

class_names = [
    "Glioma",
    "Meningioma",
    "Pituitary",
    "No Tumor"
]

# ---------------------------------------------------------
# Calculate overall accuracy directly from matrix
# ---------------------------------------------------------

correct_predictions = int(np.trace(cm))
overall_accuracy = correct_predictions / total_samples

print(
    f"11G-F: Correct predictions = "
    f"{correct_predictions}/{total_samples}"
)

print(
    f"11G-G: Overall accuracy = "
    f"{overall_accuracy * 100:.4f}%"
)

# ---------------------------------------------------------
# Plot confusion matrix
# ---------------------------------------------------------

fig, ax = plt.subplots(figsize=(8.5, 7))

im = ax.imshow(
    cm,
    interpolation="nearest",
    aspect="equal",
    cmap="viridis"
)

# Color bar represents prediction count
cbar = fig.colorbar(im, ax=ax)
cbar.set_label("Number of Predictions")

# Axis labels
ax.set(
    xticks=np.arange(len(class_names)),
    yticks=np.arange(len(class_names)),
    xticklabels=class_names,
    yticklabels=class_names,
    xlabel="Predicted Label",
    ylabel="True Label",
    title="Confusion Matrix"
)

# Rotate x-axis labels
plt.setp(
    ax.get_xticklabels(),
    rotation=30,
    ha="right",
    rotation_mode="anchor"
)

# ---------------------------------------------------------
# Add prediction counts
# ---------------------------------------------------------

# Determine text color from the actual background
# so values remain visible in both dark and light cells.

norm = im.norm
cmap = im.cmap

for i in range(cm.shape[0]):
    for j in range(cm.shape[1]):

        value = int(cm[i, j])

        # Convert cell value to displayed RGB color
        r, g, b, _ = cmap(norm(value))

        # Perceived brightness of the cell
        brightness = (
            0.299 * r +
            0.587 * g +
            0.114 * b
        )

        text_color = "black" if brightness > 0.55 else "white"

        ax.text(
            j,
            i,
            f"{value}",
            ha="center",
            va="center",
            fontsize=13,
            fontweight="bold",
            color=text_color
        )

# ---------------------------------------------------------
# Clear cell boundaries
# ---------------------------------------------------------

ax.set_xticks(
    np.arange(-0.5, len(class_names), 1),
    minor=True
)

ax.set_yticks(
    np.arange(-0.5, len(class_names), 1),
    minor=True
)

ax.grid(
    which="minor",
    color="white",
    linestyle="-",
    linewidth=2.0
)

ax.tick_params(
    which="minor",
    bottom=False,
    left=False
)

plt.tight_layout()

# ---------------------------------------------------------
# Save manuscript-quality figures
# ---------------------------------------------------------

plt.savefig(
    output_png,
    dpi=300,
    bbox_inches="tight"
)

plt.savefig(
    output_svg,
    bbox_inches="tight"
)

plt.show()

print("\n11G-H: Fig. 9 generated successfully.")
print("PNG:", output_png)



