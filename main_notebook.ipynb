print(
    f"Positive masks in training set : {len(positive_df)}"
)

# =========================================================
# VERIFY FOREGROUND PIXELS DIRECTLY
# =========================================================

foreground_pixels = []

for _, row in positive_df.iterrows():

    mask = np.asarray(
        Image.open(row["mask_path"])
    )

    binary_mask = mask > 0

    foreground_pixels.append(
        int(binary_mask.sum())
    )

positive_df["foreground_pixels_verified"] = (
    foreground_pixels
)

# =========================================================
# BASIC STATISTICS
# =========================================================

values = positive_df[
    "foreground_pixels_verified"
].values

