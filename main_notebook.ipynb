                f"Epoch {epoch:02d}/{num_epochs} | "
                f"Train {progress:6.2f}% | "
                f"Batch {batch_idx:03d}/"
                f"{total_train_batches}",
                end="\r"
            )

    train_loss /= train_total

    train_acc = (
        100.0
        * train_correct
        / train_total
    )

    # Validation
    genuine_swin.eval()

    val_loss = 0.0
    val_correct = 0
    val_total = 0

    total_val_batches = len(
        val_loader_swin
    )

    with torch.no_grad():

        for batch_idx, (images, targets) in enumerate(
            val_loader_swin,
            start=1
        ):

            images = images.to(
                device,
                non_blocking=True
            )

            targets = targets.to(
                device,
                non_blocking=True
            )

            logits = genuine_swin(images)

            loss = criterion_swin(
                logits,
                targets
            )

            val_loss += (
                loss.item()
                * targets.size(0)
            )

            predictions = logits.argmax(
                dim=1
            )

            val_correct += (
                predictions == targets
            ).sum().item()

            val_total += targets.size(0)

            progress = (
                batch_idx
                / total_val_batches
                * 100
            )

            if (
                batch_idx == 1
                or batch_idx % 5 == 0
                or batch_idx == total_val_batches
            ):
                print(
                    f"Epoch {epoch:02d}/{num_epochs} | "
                    f"Validation {progress:6.2f}% | "
                    f"Batch {batch_idx:03d}/"
                    f"{total_val_batches}",
                    end="\r"
                )

    val_loss /= val_total

    val_acc = (
        100.0
        * val_correct
        / val_total
    )

    scheduler_swin.step()

    epoch_time = (
        time.time()
        - start_time
    )

    current_lr = (
        optimizer_swin
        .param_groups[0]["lr"]
    )

    history_swin.append({
        "epoch": epoch,
