        post_finetune_accuracy
    ],
    "Parameters": [
        original_parameters,
        pruned_parameters,
        pruned_parameters
    ],
    "FLOPs": [
        original_flops,
        pruned_flops,
        pruned_flops
    ]
})

print("\nActual values used for Fig. 11:")
print(
    graph_data.to_string(index=False)
)

# ============================================================
