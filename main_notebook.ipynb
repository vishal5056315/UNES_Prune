)

print("=" * 75)


for epoch in range(
    start_epoch,
    NUM_EPOCHS + 1
):

    epoch_start = time.time()

    print(
        f"\n{'=' * 75}"
    )

    print(
        f"EPOCH {epoch}/{NUM_EPOCHS} "
        f"— overall progress "
        f"{100*epoch/NUM_EPOCHS:.1f}%"
    )

    print(
        f"{'=' * 75}"
    )

    # --------------------------------------------------------------
    # Train
    # --------------------------------------------------------------

    train_loss, train_accuracy = train_one_epoch(
        model,
        train_loader
    )

    # --------------------------------------------------------------
    # Validation
    # --------------------------------------------------------------

    val_loss, val_accuracy = validate(
        model,
