import os
import numpy as np
import pandas as pd
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from torchvision import models, transforms
from PIL import Image
from tqdm.auto import tqdm

print("=" * 75)
print("STEP 10C — ORIGINAL MRI + PREDICTED MASK")
print("=" * 75)

# ============================================================================
# 1. PATHS
# ============================================================================

MANIFEST_PATH = (
    "/kaggle/working/"
    "UNES_Prune_9600_ModelInput/"
    "model_input_manifest.csv"
)

OUTPUT_DIR = (
    "/kaggle/working/"
    "UNES_Prune_9600_EfficientNetV2_OriginalMask"
)

CHECKPOINT_DIR = os.path.join(
    OUTPUT_DIR,
    "checkpoints"
)

MODEL_DIR = os.path.join(
    OUTPUT_DIR,
    "models"
)

RESULT_DIR = os.path.join(
    OUTPUT_DIR,
    "training_results"
)

os.makedirs(CHECKPOINT_DIR, exist_ok=True)
os.makedirs(MODEL_DIR, exist_ok=True)
os.makedirs(RESULT_DIR, exist_ok=True)

manifest = pd.read_csv(
    MANIFEST_PATH
)

print("\nTotal images:", len(manifest))

assert len(manifest) == 9600


# ============================================================================
# 2. DEVICE
# ============================================================================

device = torch.device(
    "cuda" if torch.cuda.is_available()
    else "cpu"
)

print("Device:", device)

if torch.cuda.is_available():

    print(
        "GPU:",
        torch.cuda.get_device_name(0)
    )


# ============================================================================
# 3. CLASS MAPPING
# ============================================================================

CLASS_NAMES = [
    "glioma",
    "meningioma",
    "pituitary",
    "notumor"
]

CLASS_TO_INDEX = {
    name: i
    for i, name in enumerate(CLASS_NAMES)
}

manifest["label"] = manifest[
    "class"
].map(CLASS_TO_INDEX)

assert manifest["label"].notna().all()


# ============================================================================
# 4. SPLITS
# ============================================================================

train_df = manifest[
    manifest["split"] == "train"
].copy()

val_df = manifest[
    manifest["split"] == "validation"
].copy()

test_df = manifest[
    manifest["split"] == "test"
].copy()

assert len(train_df) == 8000
assert len(val_df) == 800
assert len(test_df) == 800

print("\nSplit sizes:")
print("Train      :", len(train_df))
print("Validation :", len(val_df))
print("Test       :", len(test_df))


# ============================================================================
# 5. DATASET
# ============================================================================

class OriginalPlusMaskDataset(Dataset):

    def __init__(
        self,
        dataframe
    ):

        self.df = dataframe.reset_index(
            drop=True
        )

    def __len__(self):

        return len(self.df)

    def __getitem__(self, idx):

        row = self.df.iloc[idx]

        # --------------------------------------------------------------
        # Original MRI
        # --------------------------------------------------------------

        original = np.array(
            Image.open(
                row["original_image_path"]
            ).convert("L"),
            dtype=np.float32
        )

        # --------------------------------------------------------------
        # Predicted segmented image
        # --------------------------------------------------------------

        segmented = np.array(
            Image.open(
                row["segmented_image_path"]
            ).convert("L"),
            dtype=np.float32
        )

        # --------------------------------------------------------------
        # Convert segmented intensity image into a binary
        # predicted tumor mask.
        #
        # Pixels > 0 are treated as predicted tumor pixels.
        # --------------------------------------------------------------

        mask = (
            segmented > 0
        ).astype(np.float32)

        # --------------------------------------------------------------
        # Normalize original MRI to [0,1]
        # --------------------------------------------------------------

        original = original / 255.0

        # --------------------------------------------------------------
        # Two-channel input:
        #
        # Channel 0 = original MRI
        # Channel 1 = predicted tumor mask
        # --------------------------------------------------------------

        image = np.stack(
            [
                original,
                mask
            ],
            axis=0
        )

        image = torch.from_numpy(
            image
        ).float()

        label = torch.tensor(
            int(row["label"]),
            dtype=torch.long
        )

        return image, label


# ============================================================================
# 6. CREATE DATASETS
# ============================================================================

train_dataset = OriginalPlusMaskDataset(
    train_df
)

val_dataset = OriginalPlusMaskDataset(
    val_df
)

test_dataset = OriginalPlusMaskDataset(
    test_df
)


# ============================================================================
# 7. DATA LOADERS
# ============================================================================

BATCH_SIZE = 32

train_loader = DataLoader(
    train_dataset,
    batch_size=BATCH_SIZE,
    shuffle=True,
    num_workers=2,
    pin_memory=torch.cuda.is_available()
)

val_loader = DataLoader(
    val_dataset,
    batch_size=BATCH_SIZE,
    shuffle=False,
    num_workers=2,
    pin_memory=torch.cuda.is_available()
)

test_loader = DataLoader(
    test_dataset,
    batch_size=BATCH_SIZE,
    shuffle=False,
    num_workers=2,
    pin_memory=torch.cuda.is_available()
)

print("\nNumber of batches:")
print("Train:", len(train_loader))
print("Validation:", len(val_loader))
print("Test:", len(test_loader))


# ============================================================================
# 8. VERIFY INPUT
# ============================================================================

print("\n" + "-" * 75)
print("INPUT VERIFICATION")
print("-" * 75)

sample_images, sample_labels = next(
    iter(train_loader)
)

print(
    "Input tensor:",
    tuple(sample_images.shape)
)

print(
    "Labels:",
    tuple(sample_labels.shape)
)

print(
    "MRI channel range:",
    float(sample_images[:, 0].min()),
    "to",
    float(sample_images[:, 0].max())
)

print(
    "Mask channel range:",
    float(sample_images[:, 1].min()),
    "to",
    float(sample_images[:, 1].max())
)

assert sample_images.shape[1:] == (
    2,
    256,
    256
)

assert sample_labels.shape[0] == BATCH_SIZE

print("✓ Two-channel input verified")


# ============================================================================
# 9. LOAD IMAGENET-PRETRAINED EFFICIENTNETV2-S
# ============================================================================

print("\n" + "-" * 75)
print("BUILDING PRETRAINED EFFICIENTNETV2-S")
print("-" * 75)

weights = models.EfficientNet_V2_S_Weights.DEFAULT

backbone = models.efficientnet_v2_s(
    weights=weights
)

# --------------------------------------------------------------------------
# Change first convolution from 3 input channels to 2.
# --------------------------------------------------------------------------

old_conv = backbone.features[0][0]

new_conv = nn.Conv2d(
    in_channels=2,
    out_channels=old_conv.out_channels,
    kernel_size=old_conv.kernel_size,
    stride=old_conv.stride,
    padding=old_conv.padding,
    dilation=old_conv.dilation,
    groups=old_conv.groups,
    bias=(
        old_conv.bias is not None
    )
)

with torch.no_grad():

    # Channel 0 receives pretrained RGB-average information.
    pretrained_weight = old_conv.weight

    new_conv.weight[:, 0, :, :] = (
        pretrained_weight.mean(
            dim=1
        )
    )

    # Channel 1 starts from the same averaged
    # pretrained representation.
    new_conv.weight[:, 1, :, :] = (
        pretrained_weight.mean(
            dim=1
        )
    )

    if old_conv.bias is not None:

        new_conv.bias.copy_(
            old_conv.bias
        )

backbone.features[0][0] = new_conv

# Remove original classifier.
backbone.classifier = nn.Identity()


# ============================================================================
# 10. 1536-D FEATURE + CLASSIFIER MODEL
# ============================================================================

class EfficientNetV2_OriginalMask_1536(
    nn.Module
):

    def __init__(self):

        super().__init__()

        self.backbone = backbone

        self.feature_projection = nn.Sequential(
            nn.Linear(
                1280,
                1536
            ),
            nn.BatchNorm1d(1536),
            nn.ReLU(inplace=True),
            nn.Dropout(0.2)
        )

        self.classifier = nn.Linear(
            1536,
            4
        )

    def forward(
        self,
        x,
        return_features=False
    ):

        x = self.backbone(x)

        features = self.feature_projection(
            x
        )

        logits = self.classifier(
            features
        )

        if return_features:

            return logits, features

        return logits


