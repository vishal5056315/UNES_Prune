        .sum()
    )

    required = 2400

    print(
        f"{class_name:12s}: "
        f"available={count:5d} | "
        f"required={required:5d}"
    )

    if count < required:
        raise RuntimeError(
            f"Not enough unique images for class "
            f"{class_name}"
        )

# ---------------------------------------------------------------------------
# STEP 5 — CREATE CLEAN BALANCED SPLIT
# ---------------------------------------------------------------------------
print("\n" + "-" * 75)
print("STEP 5 — CREATING CLEAN BALANCED SPLIT")
print("-" * 75)

clean_records = []

for class_name in CLASSES:

    class_df = unique_original_df[
        unique_original_df["class"] == class_name
    ].copy()

    # Deterministic shuffle
    class_df = class_df.sample(
        frac=1,
        random_state=SEED
    ).reset_index(drop=True)

    train_n = SPLIT_TARGETS["train"]
    val_n = SPLIT_TARGETS["validation"]
    test_n = SPLIT_TARGETS["test"]

    required = train_n + val_n + test_n

    selected = class_df.iloc[:required].copy()

    if len(selected) != required:
        raise RuntimeError(
            f"Incorrect number selected for {class_name}"
        )

    selected = selected.reset_index(drop=True)

    # Train
    train_part = selected.iloc[
        :train_n
    ].copy()

    train_part["split"] = "train"

    # Validation
    val_part = selected.iloc[
        train_n:train_n + val_n
    ].copy()

    val_part["split"] = "validation"

    # Test
    test_part = selected.iloc[
        train_n + val_n:
        train_n + val_n + test_n
    ].copy()

    test_part["split"] = "test"

    for part in [
        train_part,
        val_part,
        test_part
    ]:

        clean_records.extend(
            part.to_dict("records")
        )

clean_df = pd.DataFrame(clean_records)

