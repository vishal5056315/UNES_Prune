    f"{parameter_reduction:.4f}%"
)

print(
    "FLOPs reduction:",
    f"{flops_reduction:.4f}%"
)

print("Progress: 80% - model-size values calculated")

# ============================================================
# Construct graph data from retrieved experiment values
# ============================================================

graph_data = pd.DataFrame({
    "Model Version": [
        "Original",
        "Pruned 49.37% Before Fine-tuning",
        "Pruned 49.37% After Fine-tuning"
    ],
