# ---------------------------------------------------------
# Timing function
# ---------------------------------------------------------
def measure_inference_time(model, x, warmup=20, runs=100):

    model.eval()

    with torch.no_grad():

        # Warm-up
        for _ in range(warmup):
            _ = model(x)

        if device.type == "cuda":
            torch.cuda.synchronize()

        start = time.perf_counter()

        for _ in range(runs):
            _ = model(x)

        if device.type == "cuda":
            torch.cuda.synchronize()

        elapsed = time.perf_counter() - start

    return (elapsed / runs) * 1000


# ---------------------------------------------------------
# Original Swin
# ---------------------------------------------------------
original_time = measure_inference_time(
    model,
    sample,
    warmup=20,
    runs=100
)

print(f"Original Swin inference : {original_time:.3f} ms/image")


# ---------------------------------------------------------
# 49.37% pruned Swin
# ---------------------------------------------------------
pruned_time = measure_inference_time(
    pruned_model,
    sample,
    warmup=20,
    runs=100
)

print(f"49.37% pruned inference: {pruned_time:.3f} ms/image")


# ---------------------------------------------------------
# Difference
# ---------------------------------------------------------
