# ============================================================================
# 9. TRAINING FUNCTIONS
# ============================================================================

def run_train_epoch(model, loader):

    model.train()

    running_loss = 0.0
    correct = 0
    total = 0

    progress = tqdm(
        loader,
        desc="Training",
        leave=False
    )

    for batch_idx, (features, labels) in enumerate(progress):

        features = features.to(
            device,
            non_blocking=True
        )

        labels = labels.to(
            device,
            non_blocking=True
        )

        optimizer.zero_grad(
            set_to_none=True
        )

        outputs = model(features)

        loss = criterion(
            outputs,
            labels
        )

        loss.backward()

        optimizer.step()

        batch_size = labels.size(0)

        running_loss += (
            loss.item() * batch_size
        )

        predictions = outputs.argmax(
            dim=1
        )

        correct += (
            predictions == labels
        ).sum().item()

        total += batch_size

        percent = (
            (batch_idx + 1)
            / len(loader)
            * 100
        )

        progress.set_postfix(
            loss=f"{loss.item():.4f}",
            acc=f"{100*correct/total:.2f}%",
            progress=f"{percent:.1f}%"
        )

    epoch_loss = running_loss / total
    epoch_accuracy = 100.0 * correct / total

    return epoch_loss, epoch_accuracy


@torch.no_grad()
def run_validation_epoch(model, loader):

    model.eval()

    running_loss = 0.0
    correct = 0
    total = 0

    progress = tqdm(
        loader,
        desc="Validation",
        leave=False
    )

    for batch_idx, (features, labels) in enumerate(progress):

        features = features.to(
            device,
            non_blocking=True
        )

        labels = labels.to(
            device,
            non_blocking=True
        )

        outputs = model(features)

        loss = criterion(
            outputs,
            labels
        )

        batch_size = labels.size(0)

        running_loss += (
            loss.item() * batch_size
        )

        predictions = outputs.argmax(
            dim=1
        )

        correct += (
            predictions == labels
        ).sum().item()

        total += batch_size

        percent = (
            (batch_idx + 1)
            / len(loader)
            * 100
        )

        progress.set_postfix(
            loss=f"{loss.item():.4f}",
            acc=f"{100*correct/total:.2f}%",
            progress=f"{percent:.1f}%"
        )

    epoch_loss = running_loss / total
    epoch_accuracy = 100.0 * correct / total

    return epoch_loss, epoch_accuracy


# ============================================================================
# 10. TRAIN
# ============================================================================

print("\n" + "=" * 75)
print("STARTING SWIN TRANSFORMER TRAINING")
print("=" * 75)

print(f"Total epochs       : {NUM_EPOCHS}")
print(f"Starting epoch     : {start_epoch}")
