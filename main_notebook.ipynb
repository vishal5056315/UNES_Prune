# The classes below are rebuilt here so this cell remains independently
# executable after a Kaggle kernel restart.

class FeaturePatchEmbedding(nn.Module):

    def __init__(
        self,
        input_dim=1536,
        height=48,
        width=32,
        patch_size=4,
        embed_dim=96
    ):
        super().__init__()

        assert height * width == input_dim
        assert height % patch_size == 0
        assert width % patch_size == 0

        self.height = height
        self.width = width
        self.patch_size = patch_size

        self.num_patches_h = height // patch_size
        self.num_patches_w = width // patch_size
        self.num_tokens = (
            self.num_patches_h *
            self.num_patches_w
        )

        self.projection = nn.Linear(
            patch_size * patch_size,
            embed_dim
        )

    def forward(self, x):

        B = x.shape[0]

        x = x.reshape(
            B,
            self.height,
            self.width
        )

        x = x.unfold(
            1,
            self.patch_size,
            self.patch_size
        ).unfold(
            2,
            self.patch_size,
            self.patch_size
        )

        x = x.contiguous()

        x = x.reshape(
            B,
            self.num_patches_h,
            self.num_patches_w,
            self.patch_size * self.patch_size
        )

        x = x.reshape(
            B,
            self.num_tokens,
            self.patch_size * self.patch_size
        )

        x = self.projection(x)

        return x


class SwinTransformerBlock(nn.Module):

    def __init__(
        self,
        dim,
        num_heads,
        window_size=4,
        shift_size=0,
        mlp_ratio=4.0,
        dropout=0.0
    ):
        super().__init__()

        self.shift_size = shift_size

        self.norm1 = nn.LayerNorm(dim)

        self.attention = nn.MultiheadAttention(
            embed_dim=dim,
            num_heads=num_heads,
            dropout=dropout,
            batch_first=True
        )

        self.norm2 = nn.LayerNorm(dim)

        hidden_dim = int(
            dim * mlp_ratio
        )

        self.mlp = nn.Sequential(
    nn.Linear(dim, hidden_dim),
    nn.GELU(),
    nn.Dropout(0.0),
    nn.Linear(hidden_dim, dim)
)

    def forward(self, x):

        shortcut = x

        x_norm = self.norm1(x)

        if self.shift_size > 0:

            x_attn = torch.roll(
                x_norm,
                shifts=-self.shift_size,
                dims=1
            )

        else:

            x_attn = x_norm

        attn_output, _ = self.attention(
            x_attn,
            x_attn,
            x_attn,
            need_weights=False
        )

        if self.shift_size > 0:

            attn_output = torch.roll(
                attn_output,
                shifts=self.shift_size,
                dims=1
            )

        x = shortcut + attn_output

        x = x + self.mlp(
            self.norm2(x)
        )

        return x


class UNES_Prune_Swin(nn.Module):

    def __init__(
        self,
        input_dim=1536,
        embed_dim=96,
        num_classes=4
    ):
        super().__init__()

        self.patch_embedding = FeaturePatchEmbedding(
            input_dim=input_dim,
            height=48,
            width=32,
            patch_size=4,
            embed_dim=embed_dim
        )

        self.stage1 = nn.Sequential(
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=0
            ),
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=2
            )
        )

        self.stage2 = nn.Sequential(
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=0
            ),
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=2
            )
        )

        self.stage3 = nn.Sequential(
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=0
            ),
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=2
            )
        )

        self.stage4 = nn.Sequential(
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=0
            ),
            SwinTransformerBlock(
                dim=embed_dim,
                num_heads=3,
                window_size=4,
                shift_size=2
            )
        )

        self.norm = nn.LayerNorm(embed_dim)

        self.pool = nn.AdaptiveAvgPool1d(1)

        self.classifier = nn.Linear(
            embed_dim,
            num_classes
        )

    def forward(self, x):

        x = self.patch_embedding(x)

        x = self.stage1(x)
        x = self.stage2(x)
        x = self.stage3(x)
        x = self.stage4(x)

        x = self.norm(x)

        x = x.transpose(1, 2)

        x = self.pool(x)

        x = x.squeeze(-1)

        logits = self.classifier(x)

        return logits


