import os
import numpy as np
import torch
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score

print("=" * 80)
print("VERIFYING RECONSTRUCTED ORIGINAL SWIN")
print("=" * 80)

# ---------------------------------------------------------
# Locate saved test features
# ---------------------------------------------------------
FEATURE_FILE = (
    "/kaggle/working/"
    "UNES_Prune_9600_EfficientNetV2_Clean/"
    "extracted_features/"
    "test_features.npz"
)

data = np.load(FEATURE_FILE)

X_test = data["features"]
y_test = data["labels"]

print("Test features :", X_test.shape)
print("Test labels   :", y_test.shape)

# ---------------------------------------------------------
# Convert to the Swin input format
# ---------------------------------------------------------
X_test_tensor = torch.tensor(
    X_test,
    dtype=torch.float32
).reshape(
    -1, 96, 16
)

y_test_tensor = torch.tensor(
    y_test,
    dtype=torch.long
)

device = torch.device(
    "cuda" if torch.cuda.is_available() else "cpu"
)

original = original.to(device)
original.eval()

X_test_tensor = X_test_tensor.to(device)
y_test_tensor = y_test_tensor.to(device)

# ---------------------------------------------------------
# Inference
# ---------------------------------------------------------
all_predictions = []

with torch.no_grad():

    for start in range(
        0,
        len(X_test_tensor),
        64
    ):

        batch = X_test_tensor[
            start:start + 64
        ]

        logits = original(batch)

        predictions = torch.argmax(
            logits,
            dim=1
        )

        all_predictions.extend(
            predictions.cpu().numpy()
        )

predictions = np.asarray(
    all_predictions
)

labels = y_test_tensor.cpu().numpy()

# ---------------------------------------------------------
# Metrics
# ---------------------------------------------------------
accuracy = accuracy_score(
    labels,
    predictions
)

macro_precision = precision_score(
    labels,
    predictions,
    average="macro",
    zero_division=0
)

macro_recall = recall_score(
    labels,
    predictions,
    average="macro",
    zero_division=0
)

macro_f1 = f1_score(
    labels,
    predictions,
    average="macro",
    zero_division=0
)

# ---------------------------------------------------------
# Confusion matrix
# ---------------------------------------------------------
from sklearn.metrics import confusion_matrix

cm = confusion_matrix(
    labels,
    predictions,
    labels=[0, 1, 2, 3]
)

print("\nTest results:")
print(
    f"Accuracy         : {accuracy * 100:.4f}%"
)
print(
    f"Macro Precision  : {macro_precision * 100:.4f}%"
)
print(
    f"Macro Recall     : {macro_recall * 100:.4f}%"
)
print(
    f"Macro F1         : {macro_f1 * 100:.4f}%"
)

print("\nConfusion matrix:")
print(cm)

# ---------------------------------------------------------
# Compare with the saved result
# ---------------------------------------------------------
EXPECTED_ACCURACY = 96.8750

difference = (
    accuracy * 100
    - EXPECTED_ACCURACY
)

print("\nVerification against saved result:")
print(
    f"Saved accuracy       : {EXPECTED_ACCURACY:.4f}%"
)
print(
    f"Reconstructed result : {accuracy * 100:.4f}%"
)
print(
    f"Difference           : {difference:+.4f} percentage points"
)

print("\nVerification completed: 100%")


