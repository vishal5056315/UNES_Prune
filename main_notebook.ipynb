# STEP 12C: VERIFY EFFICIENTNETV2-S + 1536-D FEATURE PROJECTION
# ================================================================

import torch
import torch.nn as nn
import torchvision.models as models

print("=" * 70)
print("STEP 12C: VERIFYING EFFICIENTNETV2-S + 1536-D PROJECTION")
print("=" * 70)

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# ---------------------------------------------------------------
# [1/5] Load EfficientNetV2-S
# ---------------------------------------------------------------
print("\n[1/5] Loading EfficientNetV2-S...")
print("-" * 60)

# Do not download weights yet.
# First verify the architecture and parameter count.
backbone = models.efficientnet_v2_s(weights=None)

backbone_params = sum(
    p.numel()
    for p in backbone.parameters()
)

print(f"Backbone                    : EfficientNetV2-S")
print(f"Backbone parameters          : {backbone_params:,}")
print(f"Backbone parameters (M)      : {backbone_params / 1e6:.3f} M")
print(f"Backbone pooled dimension    : {backbone.classifier[1].in_features}")


# ---------------------------------------------------------------
# [2/5] Remove the classification layer
# ---------------------------------------------------------------
print("\n[2/5] Preparing feature-extraction backbone...")
print("-" * 60)

# EfficientNetV2-S:
# features -> adaptive average pooling -> flatten
feature_backbone = nn.Sequential(
    backbone.features,
    backbone.avgpool,
    nn.Flatten()
)

print("Classification layer removed.")
print("Feature backbone output     : 1280 dimensions")


# ---------------------------------------------------------------
# [3/5] Add the 1536-D feature projection described by manuscript
# ---------------------------------------------------------------
print("\n[3/5] Adding 1536-dimensional feature projection...")
print("-" * 60)

feature_projection = nn.Linear(
    1280,
    1536
)

projection_params = sum(
    p.numel()
    for p in feature_projection.parameters()
)

total_params = backbone_params - sum(
    p.numel()
    for p in backbone.classifier.parameters()
) + projection_params

print("Projection                  : Linear(1280 -> 1536)")
print(f"Projection parameters       : {projection_params:,}")
print(f"Combined parameters        : {total_params:,}")
print(f"Combined parameters (M)    : {total_params / 1e6:.3f} M")

print("\nManuscript-reported values:")
print("  Model parameters          : 24 M")
print("  Feature vector dimension  : 1,536")


# ---------------------------------------------------------------
# [4/5] Test complete feature-extraction path
# ---------------------------------------------------------------
print("\n[4/5] Testing feature-extraction path...")
print("-" * 60)

feature_backbone = feature_backbone.to(device)
feature_projection = feature_projection.to(device)

feature_backbone.eval()
feature_projection.eval()

# Test with one MRI-sized image.
dummy_input = torch.randn(
    1, 3, 256, 256,
    device=device
)

with torch.no_grad():

    backbone_features = feature_backbone(dummy_input)

    projected_features = feature_projection(
        backbone_features
    )

print(f"Input shape                 : {tuple(dummy_input.shape)}")
print(f"Backbone feature shape      : {tuple(backbone_features.shape)}")
print(f"Projected feature shape     : {tuple(projected_features.shape)}")


# ---------------------------------------------------------------
# [5/5] Final compatibility check
# ---------------------------------------------------------------
print("\n[5/5] Final configuration check...")
print("-" * 60)

checks = {
    "Backbone is EfficientNetV2-S":
        True,

    "Backbone pooled dimension = 1280":
        backbone_features.shape[1] == 1280,

    "Projected feature dimension = 1536":
        projected_features.shape[1] == 1536,

    "Total parameters close to manuscript 24 M":
        abs((total_params / 1e6) - 24.0) < 1.0
}

all_pass = True

for check_name, passed in checks.items():

    status = "PASS" if passed else "FAIL"

    print(f"{status}: {check_name}")

    if not passed:
        all_pass = False


print("\n" + "=" * 70)

if all_pass:
    print("STEP 12C COMPLETE")
    print("=" * 70)
    print("EfficientNetV2-S + 1536-D projection is")
    print("compatible with the manuscript-reported configuration.")
else:
    print("STEP 12C REQUIRES FURTHER VERIFICATION")
    print("=" * 70)

print("\nIMPORTANT:")
print("No 9,600-image feature extraction was performed.")
print("No pretrained weights were downloaded in this step.")
print("=" * 70)


